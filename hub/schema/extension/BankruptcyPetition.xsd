			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:SpecialCircumstanceDeductionDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:SpecialCircumstanceDeductionAmount" minOccurs="0"/>
