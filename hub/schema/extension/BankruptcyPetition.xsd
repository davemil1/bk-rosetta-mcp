<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:bkcmecf="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/cmecf/1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:niem-xsd="http://niem.gov/niem/proxy/xsd/2.0" xmlns:s="http://niem.gov/niem/structures/2.0" xmlns:nc="http://niem.gov/niem/niem-core/2.0" xmlns:j="http://niem.gov/niem/domains/jxdm/4.0" xmlns:bank="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/codes/1.0" xmlns:cmecfcodes="http://cmecf.td.oca.ao.dcn/niem/cmecf/codes/1.0" xmlns="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/cmecf/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/cmecf/1.0">
	<xsd:annotation>
		<xsd:documentation>National Information Exchange Model XML schema extension for Bankruptcy Cases in CMM/ECF, specifically for conveying all of the data elements in the Bankruptcy forms.</xsd:documentation>
		<xsd:appinfo>
			<s:ConformanceIndicator>true</s:ConformanceIndicator>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:import namespace="http://niem.gov/niem/niem-core/2.0" schemaLocation="../niem-core/2.0/niem-core.xsd"/>
	<xsd:import namespace="http://niem.gov/niem/structures/2.0" schemaLocation="../structures/2.0/structures.xsd"/>
	<xsd:import namespace="http://niem.gov/niem/domains/jxdm/4.0" schemaLocation="../jxdm/4.0/jxdm.xsd"/>
	<xsd:import namespace="http://niem.gov/niem/proxy/xsd/2.0" schemaLocation="../proxy/xsd/2.0/niem-xsd.xsd"/>
	<xsd:import namespace="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/codes/1.0" schemaLocation="BkPetitionCodeLists.xsd"/>
	<xsd:import namespace="http://cmecf.td.oca.ao.dcn/niem/cmecf/codes/1.0" schemaLocation="../county_codes/1.0/USCountyCodes.xsd"/>
	<xsd:element name="AccountCode" type="bkcmecf:AccountCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of the account type.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AccountNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Unique identifier of a debtor's account number with a creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdditionalAssetsAddress" type="nc:StructuredAddressType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding an address where additional debtor assets are located.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdditionalExpenseDeductionsTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total additional expense deductions under section 707(b)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdditionalFoodClothingExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly amount by which debtor expenses for food and clothing exceed the IRS allowances</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdditionalHomeEnergyCostsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Home energy costs that are more than the home energy costs included in expenses allowed as specified by IRS Local Standards for Housing and Utilities.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdditionalPublicTransportationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly amount by which debtor expenses for public transit exceed the IRS allowances</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdjustedCurrentMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor's adjusted current monthly income amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AdversaryProceedingRelatedCase" type="j:CaseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold any Adversarial Proceedings related to the current case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Alias" type="bkcmecf:AliasType" substitutionGroup="nc:PersonAlternateName" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An alternate name for some entity, categorized by type.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AliasTypeCode" type="bkcmecf:AliasCategoryCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code for different types of aliases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AlimonyMaintenanceAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly household income of a debtor arising from alimony and maintenance payments.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AlimonyMaintenanceSupportPaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly household expenses of a debtor arising from alimony and other support paid to others.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AllowableFoodClothingDeductionsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of debtor's food and clothing expenses that can be deducted under IRS standards.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AllowableHealthCareDeductionsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of debtor's health care expenses that can be deducted under IRS standards.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AttachedAdditionalPagesIndicator" type="bkcmecf:IndicatorType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if additional pages to a schedule or statement were attached to the petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AttachedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if debtor's property was attached, seized or levied.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AttorneySignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element indicating the date an attorney signed a document.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AutoInstallmentPaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from automobile installment payments</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AutoInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from car insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AverageMonthlyPaymentAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly payment made by the debtor for debt owned to creditors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="AverageMonthlyPaymentPlanAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The product of the projected chapter 13 plan payment and the multiplication factor to be applied according to the debtor's judicial district.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyCaseVoluntaryInvoluntaryCode" type="bank:BankruptcyCaseVoluntaryInvoluntaryCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding a code of whether a Bankruptcy case has been voluntarily or involuntarily filed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyChapter" type="bank:BankruptcyChapterType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for storing one of the various chapters of the US Bankruptcy code that Bankruptcy cases may be filed under.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyChapterIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if filing for bankruptcy under Chapters 7, 11, or 13.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyDebtor1" type="nc:EntityType" substitutionGroup="j:CaseInitiatingParty" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person who has filed a petition for relief under the Bankruptcy Code.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyDebtor2" type="nc:EntityType" substitutionGroup="bkcmecf:BankruptcyDebtor1" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person who has filed a petition along with debtor1, for relief under the Bankruptcy Code.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyForm" type="bkcmecf:BankruptcyFormType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A official form submitted in the federal court, to initiate a legal procedure for dealing with debt problems of individuals and businesses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyFraudIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Debtor indicates knowledge that bankruptcy fraud is a serious crime.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyPetition" type="bkcmecf:BankruptcyPetitionType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Information needed to initiate bankruptcy cases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BankruptcyPetitionSet" type="bkcmecf:BankruptcyPetitionSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An instance of a collection of Bankruptcy Petitions, for hypothetical reporting purposes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BriefingNotRequiredReasonCode" type="ReasonType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Credit counseling briefing not required reason types.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessConnectionEntity" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Details about debtor's business or have any connections to any business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessConnectionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication set to true if the debtor owns a business or have connections to any business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessDirectorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is an officer, director, or managing executive of a corporation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessFarmingExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Monthly household expenses arising from the operation of a business, profession, or farm.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessFarmingIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from operation of business or profession or farm; Schedule I field 7</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessFarmingNetIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The Net Business Income from ordinary and necessary business expenses from operation of business or profession or farm.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if  debtor's income is from operating a business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessIsAnInvestmentAdvisor" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Debtor business is an Investment advisor (as defined in 15 U.S.C. § 80b-2(a)(11))</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessIsAnInvestmentCompany" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Debtor business is an Investment company, including hedge fund or pooled investment vehicle (as defined in 15 U.S.C. § 80a-3)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessMemberIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is a member of a limited liability company (LLC) or limited liability partnership (LLP).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessNAICSCode" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>NAICS (North American Industry Classification System) 4-digit code that best describes debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessNatureOtherDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of "other" type the debtor's business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessOwnerIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is an owner of at least 5% of the voting or equity securities of a corporation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessPartnerIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is a partner in a partnership.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessProperty" type="bkcmecf:BusinessPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of business related property that the debtor owns or have any legal or equitable interest.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BusinessTaxExemptIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indication whether or not the debtor's business was of the tax-exempt variety.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CalendarYear" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Calendar year - format YYYY.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CalledToActiveDutyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if the debtor was called to active duty after 9/11 for a period of at least 90 days.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CaseStatusCode" type="bkcmecf:CaseStatusCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of the case status.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CaseTwoDigitYear" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The two-digit representation of a year commonly used as the prefix to reference a case number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CategoryOtherDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of 'Other' property category.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CauseOfActionDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A statement of the rationale for initiating a legal case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CertainLosses" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A data type for certain losses, because of theft, fire, other disaster, or gambling.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CertainLossesIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor losses were because of theft, fire, other disaster, or gambling.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CertifiedServedLandlordIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor certified that he served the landlord under section 11 362(1)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInExpensesAnticipatedDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of debtor's expenses are expected to vary significantly in the next year from the past year as recorded on expenses form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInExpensesAnticipatedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that significant changes in household expenses can reasonably be anticipated in the future.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeAnticipatedDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the anticipated changes over the next year to the net monthly income of a household.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeAnticipatedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that significant changes to income are reasonable to expect in the following year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount expected to change in debtor's income or expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of ways in which a debtor's expenses or income are expected to vary significantly in the next year from the past year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeExpenseExpected" type="bkcmecf:ChangeInIncomeExpenseExpectedType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A note that some unit of the means test of the debtors income or expenses is expected to change.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChangeInIncomeExpenseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if 122C-1 changes in income or anticipated to change in the future. Set to false if 122C-2 changes in expenses are anticipated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter11FilingIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is filing for Bankruptcy under Chapter 11.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter11PlanCode" type="bank:Chapter11PlanCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for indicating the code indicating which type of  11 plan.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter11PlanFiledIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An element for indicating whether a plan has been filed in a Chapter 11.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter13FilingEligibilityIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor is eligible to file a bankruptcy petition under Chapter 13.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter15CaseCategoryCode" type="bank:Chapter15CaseCategoryCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding a code representation of what type of Chapter 15 case this is.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Chapter7FilingIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if filing for Bankruptcy under Chapter 7.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CharitableContributionsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of household monthly charitable contributions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ChildcareEducationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor expends pursuant to childcare, such as baby-sitting, day care, nursery and preschool.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Claim" type="bkcmecf:ClaimType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Representation of a Claim of a Creditor against a debtor</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The dollar value of a claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimCollateralValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The value of property that is collateral for the claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimConsiderationDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the goods or services received in exchange for the credit extended by the creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimContingentIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator if any portion of a claim is contingent on other factors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimDeathPersonalInjuryIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator for Claims for Death or Personal Injury While Debtor Was Intoxicated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimDisputedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication if some portion of a claim is disputed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimEntitledPriorityAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monetary value of the portion of a claim that is entitled to priority under the rules of bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimIncurredDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The data a claim was incurred.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimLienIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the creditor has a lien on the debtor property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimNatureDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of a claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimOtherIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the unsecured claim is not a contingent, unliquidated or disputed claim. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimSecurityAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Value of the security that is a part of the claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimsTransferIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates that at least one claim against the debtor has been transferred to another owner.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimSubjectToOffsetIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if the claim is subject to offset</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimUnliquidatedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator if any portion of a claim is unliquidated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClaimUnsecuredPortionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The portion of a claim that is unsecured.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClassActionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>True if it is asserted that a given case is part of a class action.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ClothingServicesExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly expenditure of a household for clothing.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CoDebtor" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An instance of a person who is also liable for the debts of the debtor in Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CoDebtorEntity" type="bkcmecf:CoDebtorEntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>For the association of co-debtors and creditors for Schedule G.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CoDebtorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if codebtor(s) other than a spouse, exists in a Bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CoDebtorLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Codebtor line number (ex. 3.1, 3.2, …).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommitmentPeriodAdjustedMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Commitment period; Marital adjustment amount; deduct part of your spouse’s income</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommitmentPeriodAnnualizedMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Commitment period; Marital adjustment current monthly income for the year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommitmentPeriodDeterminationIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if household annual income is less than the applicable median family income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommitmentPeriodIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator if annual income of the debtor household is less than the applicable median family income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommitmentPeriodMaritalAdjustmentIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Deduct the marital adjustment if it applies, if married and spouse is not filing with the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommunityDebtIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Check if this claim is for a community debt</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommunityPropertyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a piece of property is a community property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommunityPropertyState" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Community state or territory that the debtor lived. Include: Arizona, California, Idaho, Louisiana, Nevada, New Mexico, Puerto Rico, Texas, Washington, and Wisconsin.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CommunityPropertyStateIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor lived with a spouse or legal equivalent in a community property state, within the last 8 years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CompensationPaid" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item to store the source of the compensation paid to the attorney.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CompensationSharedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the attorney agrees to share the compensation with persons that are not members of the attorney's firm.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CompensationToBePaid" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item to store the source of the compensation to be paid to the attorney.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Contract" type="bkcmecf:ContractType" substitutionGroup="bkcmecf:ContractRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A legally enforceable agreement whereby one or more entities who are parties agree to take some action in return for consideration.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractDescription" type="nc:TextType" substitutionGroup="bkcmecf:ContractRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of contract or lease; Nature of debtor's interest; Whether lease is for nonresidential real property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractEffectiveDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Date a contract became effective.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractEndDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Date a contract terminated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractIdentification" type="nc:IdentificationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identification number assigned to a contract.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractLeaseEntity" type="bkcmecf:ContractLeaseEntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A legally enforceable agreement whereby one or more entities who are parties agree to take some action in return for consideration.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractLeaseLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Contract or unexpired leases line number  (ex. 2.1, 2.2,...)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractNatureDebtorInterest" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element describing the nature of a debtor's interest in a executory contract or lease.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractNonresidentialRealPropertyLeaseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication whether or not a contract is a lease for non-residential property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractParty" type="nc:EntityType" substitutionGroup="bkcmecf:ContractPartyRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An entity who is a party to a legal contract.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractPartyAssociation" type="bkcmecf:ContractPartyAssociationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An instance of an association between a party and a contract.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractPartyRepresentation" abstract="true" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A party to a contract and associated details.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractReference" type="s:ReferenceType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A reference to a contract.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractRepresentation" abstract="true" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A contract and associated details.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ContractsLeasesIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if debtor is involved in executory contracts or unexpired leases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CorporationAuthorizedIndividual" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An individual allowed to represent a corporate debtor. (currently unused element)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CorporationAuthorizedIndividualName" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person who is authorized to represent a corporate debtor which is filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CorporationAuthorizedIndividualSignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The date a corporate officer signed some document.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CorporationAuthorizedIndividualTitle" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The official title of a person who is authorized to represent a corporation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseCompletionCertificateNumber" type="nc:IdentificationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A unique identifier for each completed course in personal financial management, provided by the Department of Justice U.S. Trustees program.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseCompletionDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The date a financial management course was completed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseCompletionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that someone has asserted the completion of a course in personal financial management.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseCompletionNotRequiredIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that someone has asserted that the completion of a course in personal financial management is not required in current circumstances.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseProvider" type="nc:OrganizationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An organization that provides a financial management course.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourseWaiverReasonCode" type="WaiverReasonType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Financial management course waiver requested reason types.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourtDivisionalOfficeCode" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person or organization that has a claim to the services of a second party; an entity to whom money is owed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CourtOrderedSupportPaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor is required to pay pursuant to the order of a court or administrative agency, such as spousal or child support payments.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditCounselingCode" type="bkcmecf:CreditCounselingCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Credit counseling code types.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Creditor" type="bkcmecf:CreditorType" substitutionGroup="bkcmecf:CreditorRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Representation of the role of a creditor in a bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorAddressOverideIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication whether or not the Bankruptcy Noticing Center should override the listed address with one on file that is supposed to be used for large creditors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorCategoryCode" type="bkcmecf:CreditorCategoryCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Enumeration of allowed categories of creditors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorCommitteeMemberIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication whether or not the creditor is a member of a creditors committee.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorDescription" type="nc:TextType" substitutionGroup="bkcmecf:CreditorRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A single block of text describing an entity who is a creditor in a Bankruptcy case, containing name and address information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorDetails" type="bkcmecf:CreditorDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Creditor details - name, address.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorEndDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A date a creditor ended their association with a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorEntityIndividualCode" type="bkcmecf:CreditorEntityIndividualCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Distinguishes individual creditors from creditors who are collective entities.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorID" type="nc:IdentificationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Unique identifier of a creditor record within the cmecf system.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorMatrix" type="bkcmecf:CreditorMatrixType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A list of Creditors and their details submitted along with the petition, that are not on the schedules.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorPayment" type="bkcmecf:CreditorPaymentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Information about payments to creditors in a Bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorPaymentAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monetary amount of a payment to a creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorPaymentDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The date a payment to a creditor occurred.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorPaymentDetails" type="bkcmecf:DebtorPaymentDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List of creditors to whom the the debtor made a payment not including domestic support obligations.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorReference" type="s:ReferenceType" substitutionGroup="CreditorRepresentation" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A reference to a creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorRepresentation" abstract="true" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A creditor and associated details.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorSetoff" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A recording of a creditor set off any amounts from the debtor's accounts or refuse to make a payment because of a owed debt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorSetoffAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount of money a creditor set off funds against a debt owed them by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CreditorStartDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A date a creditor got involved in a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CurrentYear" type="bkcmecf:FiscalYearType">
		<xsd:annotation>
			<xsd:documentation>Current Year Fiscal information for Form B107.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CurrentYearEmploymentBusinessIncome" type="bkcmecf:DebtorEmploymentBusinessIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Employment or business income for debtor during the current year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CurrentYearIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Current Year Income amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CurrentYearOtherIncome" type="bkcmecf:DebtorOtherIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other income for debtor during the current year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="CustodianAppointedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if a custodian, other than a trustee is appointed to take charge of less than substantially all of the property of the debtor for the purpose of enforcing a lien against such property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DateText" type="nc:TextType" substitutionGroup="nc:DateRepresentation">
		<xsd:annotation>
			<xsd:documentation>A textual representation of a date.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1AverageMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly income that the debtor received from all sources, derived during the 6 full months before filling the bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1CreditCounseling" type="bkcmecf:CreditCounselingType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Instance of representation of an individual's efforts to receive a briefing about credit counseling.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1CurrentMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The TOTAL of debtor1 current monthly income amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1Employment" type="bkcmecf:DebtorEmploymentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A structure for holding debtor1 employment information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1ExemptProperty" type="bkcmecf:DebtorExemptPropertyType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Property claimed as exempt by debtor1.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1FilingVenue" type="bkcmecf:FilingVenueType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Filing venue established by debtor1.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1Income" type="bkcmecf:DebtorIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Employment or business income for debtor1 during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1IncomeSource" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B107 field .</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1Indicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true to indicate debtor1 is a member of the household.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1MonthlyIncome" type="bkcmecf:MonthlyIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Instance of representation of Debtor1's income, used in Schedule I: Current Income of Individual Debtor(s).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1MonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor1 total monthly income as reported on Schedule I.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1OtherIncome" type="bkcmecf:OtherIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other income for debtor during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1PriorAddress" type="bkcmecf:PriorAddressType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A set of data about prior addresses of the debtor1, as reported on financial statement form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor1SignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date the debtor signed their petition for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2AverageMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly income that the debtor2 or non-fling spouse received from all sources, derived during the 6 full months before filling the bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2CreditCounseling" type="bkcmecf:CreditCounselingType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Instance of representation of an individual's efforts to receive a briefing about credit counseling.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2CurrentMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The TOTAL of debtor2 or non-filing spouse current monthly income amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2DataIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the data for Debtor2 or non filing spouse has been filled out.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2Employment" type="bkcmecf:DebtorEmploymentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A structure for holding debtor2 employment information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2ExemptProperty" type="bkcmecf:DebtorExemptPropertyType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Property claimed as exempt by debtor2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2FilingVenue" type="bkcmecf:FilingVenueType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Filing venue established by debtor2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2Income" type="bkcmecf:DebtorIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Employment or business income for debtor2 during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2Indicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if Debtor2 is filing for bankruptcy, along with Debtor1.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2MonthlyExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor2 monthly expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2MonthlyIncome" type="bkcmecf:MonthlyIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Instance of representation of Debtor2's income, used in Schedule I: Current Income of Individual Debtor(s).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2MonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor2 total monthly income as reported on Schedule I.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2OtherIncome" type="bkcmecf:OtherIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other income for debtor during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2PriorAddress" type="bkcmecf:PriorAddressType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A set of data about prior addresses of the debtor2, as reported on financial statement form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2ResidentialAddressIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor2 residential address is same as debtor1 residential address.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2SeparateHouseholdIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor and their spouse are living  separately or are  legally separated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Debtor2SignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date the joint debtor signed their petition for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorAttorney" type="nc:EntityType" substitutionGroup="nc:ObligationRecipient" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An attorney for debtors filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorBusinessAddress" type="nc:StructuredAddressType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding an address where Sole Proprietorship Address information is located located.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorBusinessName" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Name of the business that the debtor is a sole proprietor. .</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorEstimatedAssetsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of assets on the summary of schedules.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorExpendituresExistIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that debtor expenses exist and thus schedule J must be completed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorForeignRepresentativeName" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the name of the foreign representative of the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorIncomeAdjustmentsTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The TOTAL amount of all adjustments to debtor's income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorIncomeExistsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that the debtor has some income and thus Schedule I must be completed</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorIncomeSource" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B107 field .</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorInvolvementDate" type="nc:DateRangeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The date(s) an entity was involved with a debtor in some way. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorNonPriorityUnsecuredDebtTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor's NonPriority Unsecured Debt Total Amount</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorOwedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount still owed by the debtor to creditors or insiders.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorOwnedVehiclesQuantityCode" type="bkcmecf:DebtorOwnedVehiclesQuantityCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code indicating how many vehicles the debtor owns (0,1,2 or more)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorOwnRealPropertyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if debtor owns a piece of real property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorRelationshipDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Description of relationship of debtor to someone else, such as a creditor or a payer of filing fees.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorRelationshipRoleCode" type="bkcmecf:DebtorRelationshipRoleCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Relationship of debtor to a person who pays their filing fee.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorRentsResidenceIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor rents their residence.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorSpecificOtherTypeOrganization" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Another type of debtor form of organization not specifically enumerated on form B1</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorSpouse" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A current or former spouse of the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorTelephoneNumber" type="nc:TelephoneNumberType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element to hold the debtor's telephone number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorThresholdDebtPaymentAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The debtors total non-priority unsecured debt, multiplied by 0.25</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtorTypeCode" type="bank:DebtorTypeCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of types of debtor: individual (i), corporation (u), partnership (p), or other (n).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtsBelowThresholdIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An element for indicating whether the debts in a Chapter 11 case are below the statutory threshold.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtSecuredIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if any debts listed are secured by primary residence, a vehicle, or other property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtSecurity" type="bkcmecf:PropertyItemType">
		<xsd:annotation>
			<xsd:documentation>A security issued by some organization to raise money.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtsIncurredPrimarilyOnActiveDutyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Did Debtor incur debts mostly while were on active duty or while you were performing a homeland defense activity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DebtSubordinatedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator on the petition, that the debt security item is subordinated; not so if value is false.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DefendantPartyRoleCode" type="bkcmecf:PartyRoleCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A categorization of a defendant in a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DemandAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount demanded by a pleading in a lawsuit.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Dependent" type="DependentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person supported by someone else.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DependentChildrenSupportAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An amount received for support for dependent children.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DependentLiveWithDebtorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a dependent lives with the debtor that references them on Schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DependentsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor1 and/or debtor2 have dependents.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DepositForRentIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that the debtor included rent with their deposit to the court.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisabilityInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor expends on disability insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisabledVeteranIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indication whether or not the Debtor is a Disabled Veteran.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisposableIncomeDeterminationIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether or not disposable income will be determined.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisposableIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if disposable income is determined under 11 U.S.C. § 1325(b)(3).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisposableMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of monthly disposable income at the debtor's command.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DisposableSixtyMonthsIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount of monthly disposable income the debtor is calculated to have over the next five years under the means test.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DomesticSupportDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payroll deductions for domestic support obligations</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DomesticSupportPaymentIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if a payment made to a creditor is for domestic support.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DomesticSupportPaymentsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor is required to pay pursuant to the order of a court or administrative agency, such as spousal or child support payments.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EducationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total average monthly expenses the debtor actually incurs for sending dependent children to school, not already accounted for in the IRS Standards.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EmploymentBusinessIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor have employment or business income during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EmploymentDetails" type="bkcmecf:EmploymentDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A structure for holding debtor employer information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EmploymentDuration" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A duration of time, how long the debtor is employed with an employer.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EmploymentStatusIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Subject is employed if true, unemployed if false.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EntityStillOwnedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor still have the property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EnvironmentalLawCase" type="bkcmecf:LegalActionsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor been a party in any judicial or administrative proceeding under any environmental law.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EnvironmentalLawCaseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor has been a party in any judicial or administrative proceeding under any environmental law.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstablishedByAffiliateIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the venue for filing a bankruptcy petition was established by affiliation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstablishedByDomicileIndicator" type="bkcmecf:IndicatorType">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the venue for filing a bankruptcy petition was established by the debtor's living location.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstablishedByOtherDescription" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A description of the other reason why the venue for filing a given bankruptcy petition was established.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstablishedByOtherIndicator" type="bkcmecf:IndicatorType">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the venue for filing a bankruptcy petition was established by other reason.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstimatedAssetsCode" type="bank:EstimatedAssetsCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of value of assets range that the debtor own.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstimatedCreditorsCode" type="bank:EstimatedCreditorsCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of range of number of creditors that the debtor owe money.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="EstimatedLiabilitiesCode" type="bank:EstimatedLiabilitiesCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of value of liabilities range that the debtor owes to creditors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExemptClaimLaws" type="bkcmecf:ExemptClaimLawsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The legal rationale why an item of property of the debtor is exempt from the bankruptcy pool of assets.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExemptClaimPortionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The dollar value of the portion of an item of property of the debtor that is exempt from the bankruptcy pool of assets.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExemptClaimPortionCode" type="bkcmecf:ExemptClaimPortionCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code for the amount of the exemption you claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExemptProperty" type="bkcmecf:ExemptPropertyType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of personal property that is asserted to be claimed as exempt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExemptPropertyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor claims the property as exempt on Schedule C.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ExpensesIncludedForNonHouseholdIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor's expenses include expenses of people other than the debtor and their dependents.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FarmingProperty" type="bkcmecf:FarmingPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of farming and fishing related property that the debtor owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FilePeriodicReportsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor is required to file periodic reports with the SEC.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FilerAwarePendingCaseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is aware of any pending bankruptcy cases by or against any partner, spouse, or their affiliates.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FilingFeeStatusCode" type="bank:FilingFeeStatusCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of the type of filing fees allowable in a bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FilingFeeUnableToPayDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description why the debtor is unable to pay the filing fee in installments within 120 days..	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialAccounts" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Include checking, savings, money market, or other financial accounts; certificates of deposit; shares in banks, credit unions, brokerage houses, pension funds, cooperatives, associations, and other financial institutions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialAccountsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if within 1 year before filing for bankruptcy, any financial accounts or instruments held in the debtor's name, were closed, sold, moved, or transferred.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialAssetType" type="bkcmecf:FinancialItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Financial asset type owned by the debtor or owed to the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialEntityMain" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The main entity of an asset as recorded in the Statement of Financial Affairs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialEntityOther" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The other entity of an asset as recorded in the Statement of Financial Affairs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialManagementCourse" type="bkcmecf:FinancialManagementCourseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An instance of a financial management course.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialProperty" type="bkcmecf:FinancialPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of real property that the debtor owns or have any legal or equitable interest.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialStatementActivity" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>All financial institutions, creditors, or other parties to whom the debtor has given a financial statement about his/her business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialStatementActivityIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor has given a financial statement about his/her business to anyone in the last 2 years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialTransfereeEntity" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The entity to whom ownership of a financial asset is transfered as recorded in the Statement of Financial Affairs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialTransferorEntity" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The entity from whom ownership of a financial asset is transfered as recorded in the Statement of Financial Affairs. Often this is implicitly the debtor, and can assumed to be so if omitted.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FinancialTransferPropertyItem" type="bkcmecf:PropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of property whose transfer is tracked in the Statement of Financial Affairs Form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FoodHousekeepingExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly amount spent on food.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ForeclosedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if  debtor's property was foreclosed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ForeignProceedingPendingCountriesList" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An list of countries in which a foreign proceeding is pending, stored in a single text field.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ForeignRepresentativeOrderExistsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>A element indicating whether or not an order regarding the foreign representative of the debtor exist.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ForeignRepresentativeSignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date the foreign representative of the debtor signed their petition for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormAmendedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>True if the form containing this indicator amends a prior filing; false otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB101" type="bkcmecf:FormB101Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Voluntary Petition for Individuals Filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB101A" type="bkcmecf:FormB101AType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Initial Statement About an Eviction Judgment Against You</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB103A" type="bkcmecf:FormB103AType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Application for Individuals to Pay the Filing Fee in Installments</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB103B" type="bkcmecf:FormB103BType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Application to Have the Chapter 7 Filing Fee Waived</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB104" type="bkcmecf:FormB104Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>For Individual Chapter 11 Cases: List of Creditors Who Have the 20 Largest Unsecured Claims Against You and Are Not Insiders</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB105" type="bkcmecf:FormB105Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B105: Involuntary Petition Against an Individual.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106AB" type="bkcmecf:FormB106ABType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule A/B: Property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106C" type="FormB106CType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule C: The Property You Claim as Exempt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106D" type="bkcmecf:FormB106DType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule D: Creditors Who Have Claims Secured by Property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106Dec" type="bkcmecf:FormB106Dec" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B106 Declaration: Declaration About an Individual Debtor’s Schedules</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106EF" type="FormB106EFType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule E/F: Creditors Who Have Unsecured Claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106G" type="bkcmecf:FormB106GType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule G: Executory Contracts and Unexpired Leases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106H" type="bkcmecf:FormB106HType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule H: Codebtors</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106I" type="bkcmecf:FormB106IType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule I: Your Income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106ISupp" type="bkcmecf:FormB106IType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A post-petition filing with the same content/format as Form Current Income of Individual Debtor(s)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106J" type="bkcmecf:FormB106JType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule J: Your Expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106J2" type="bkcmecf:FormB106JType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule J-2: Expenses for Separate Household of Debtor 2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106J2Supp" type="bkcmecf:FormB106JType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A post-petition filing with the same content/format as Form Current Expenditures.for Debtor 2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106JSupp" type="bkcmecf:FormB106JType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A post-petition filing with the same content/format as Form Current Expenditures for Debtor 2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB106Sum" type="bkcmecf:FormB106SumType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B106 Summary: A Summary of Your Assets and Liabilities and Certain Statistical Information (individuals).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB107" type="bkcmecf:FormB107Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B107: Your Statement of Financial Affairs for Individuals Filing for Bankruptcy (individuals)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB108" type="bkcmecf:FormB108Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B108: Statement of Intention for Individuals Filing Under Chapter 7.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122A1" type="bkcmecf:FormB122A1Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122A1: Chapter 7 Means Test Calculation</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122A1Supp" type="bkcmecf:FormB122A1SuppType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122A1Supp: Chapter 7 Means Test Calculation</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122A2" type="bkcmecf:FormB122A2Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122A2: Chapter 7 Means Test Calculation</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122B" type="bkcmecf:FormB122BType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122B: Chapter 11 Statement of Current Monthly Income</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122C1" type="bkcmecf:FormB122C1Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122C1: Chapter 13 Statement of Current Monthly Income and Calculation of Commitment Period</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB122C2" type="bkcmecf:FormB122C2Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B122C2: Chapter 13 Statement of Current Monthly Income and Calculation of Commitment Period</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB2030" type="bkcmecf:FormB2030Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B2030: Disclosure of Compensation of Attorney for Debtor</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB2800" type="bkcmecf:FormB2800Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B2800, the Disclosure of Compensation of Bankruptcy Petition Preparer</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FormB423" type="bkcmecf:FormB423Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Form B423: Certification About a Financial Management Course.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FundsAvailableIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true the debtor estimate whether or not there will be any funds remaining after paying off all debts.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GarnishedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if  debtor's property was garnished.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GiftsToCharity" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element to hold any gifts or contributions with a total value of more than $600 to any charity, within 2 years before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GiftsToCharityIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor gave any gifts with a total value of more than $600 to any charity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GiftsToPeople" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element to hold any gifts or contributions with a total value of more than $600 per person, within 2 years before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GiftsToPeopleIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor gave any gifts to individuals, with a total value of more than $600 per person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GovernmentSupportPaymentsDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Specification of the income from Social security or government assistance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GovernmentSupportPaymentsIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from Social security or government assistance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GrossAnnualSupplementTotalIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element to hold the debtor's gross annual non-wage or other primary income in the past year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GrossAnnualSupplementTotalIncomeDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element describing the debtor's gross annual income from supplemental sources in the past year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GrossIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of Individual's gross wages and monthly overtime amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GrossWagesAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Individual's Monthly gross wages, salary, and commissions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="GrossWagesIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Source of Income indicator - set to 'true' if income is from wages, commissions, bonuses or tips.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HazardousMaterialNotified" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor notified any governmental unit of any release of hazardous material.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HazardousMaterialNotifiedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor notified any governmental unit of any release of hazardous material.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HazardousProperty" type="bkcmecf:HazardousPropertyType">
		<xsd:annotation>
			<xsd:documentation>A piece of property debtor own or have any hazardous property or any property that needs immediate attention.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HazardousPropertyAddress" type="nc:StructuredAddressType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding an address where the debtor may own any hazardous property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HazardousPropertyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that the property poses or is alleged to pose a threat of imminent and identifiable hazard to public health or safety.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthcareExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor expends pursuant to health care, that is not reimbursed by insurance, or by a health savings account, and that is in excess of the amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthExpenseActualAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor Actually expends on Health Savings Accounts, health insurance, and disability insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthExpenseActualAmountSameIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor Actually expends on Health Savings Accounts, health insurance, and disability insurance is same as calculated by form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthExpenseTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The combined total monthly amount debtor needs to expend monthly on Health Savings Accounts, health insurance, and disability insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from health insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HealthSavingsAccountExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor expends on a Health Savings Account (HSA).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HighConsumerDebtsPaidIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor paid any creditor an amount in excess of the total of $6,425(subject to adjustment on 4/1/19 and every 3 years) or more.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomeEquityMortgagePaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of additional mortgage payments for a residence, such as home equity loans.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomelandDefenseActivityCurrentlyPerformingIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor is currently performing some Homeland Security duty and has been for at least 90 days prior to filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomelandDefenseActivityPerformedEndDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Date the debtor who became either a member of the National Guard	or other Armed Forces Reserve or Homeland Security duty after 9/11 for a period of at least 90 days was released from active duty, which is less than 540 days prior to filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomelandDefenseActivityPerformedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor was released from performing some Homeland Security duty after 9/11 and less than 540 days prior to filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomeMaintenanceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The costs arising from physically maintaining a house or other dwelling</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomeownersAssociationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The costs arising Home owner's association or condominium dues.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomeownersRentersInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of monthly expense for renters or homeowners insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomeRealEstateItem" type="bkcmecf:PropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of debtor's home real estate property in a form not otherwise specified.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HomesteadExemptionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if debtor is claiming a homestead exemption of an amount greater than the threshold amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdAnnualIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total of debtor and debtor spouse's Income subtotals, multiplied by 12.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdExpenses" type="bkcmecf:HouseholdExpensesType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The expenses associated with maintaining a household</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdMembersMonthlyNetIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The net monthly income of members of a household; not including the debtor. For use on Form B3B.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdMonthlyExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of the debtor expenses and those of the debtor's spouse as reported on the expense form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Household monthly income of debtor1 and debtor2  before the expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdMonthlyNetIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Household monthly net income of debtor1 and debtor2  after deducting all the expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdPrecontributionIncome" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of the debtor income and the debtor's spouse, before household contributions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdProperty" type="bkcmecf:HouseholdPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item type of personal and household items that the debtor owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="HouseholdSizeQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The number of people in the debtor's household, on the means test.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IdentifiableInformationIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a piece of property lists include personally identifiable information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ImmediateAttentionNeededDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Describe why an immediate attention is needed for the property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IncapacityDisabilityIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that the debtor has an incapacity or disability to the extent that they are excused from the requirement of  completion of a course in personal financial management before filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IncomeExpenseLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Income or expense form line number  (ex. 13a, 13b,...)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IncomeNotUtilizedForHouseholdSupportIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator that some portion of income reported for the Debtors spouse was NOT regularly used for the household expenses of the Debtor or their dependents.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IncreaseOrDecreaseExpectedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if increase of income or expense is expected.Set to false if decrease of income or expenses expected.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="IndividualBankruptcyPetition" type="bkcmecf:IndividualBankruptcyPetitionType" substitutionGroup="bkcmecf:BankruptcyPetition" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Information needed to initiate bankruptcy cases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InitialPresumptionDeterminationCode" type="bkcmecf:InitialPresumptionDeterminationCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code indicating the presumption of abuse on the means test at first measurement</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InsiderBenefitedDetails" type="bkcmecf:DebtorPaymentDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List of insiders benefited on account of payments made by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InsiderBenefitedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor payments benefited any insider.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InsiderPaymentDetails" type="bkcmecf:DebtorPaymentDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List of insiders to whom the the debtor made a payment not including domestic support obligations.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InsiderPaymentIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor paid any insider on a debt owed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InstallmentPayment" type="bkcmecf:InstallmentPaymentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A data type for installment payment type, that the debtor proposes to pay.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InstallmentPaymentWithFilingIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the first installment of a filing fee is to be paid at the time of the filing of a petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InsuranceDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payroll insurance deductions</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Inventory" type="bkcmecf:InventoryType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The activity of taking stock of the value of some collection of items.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InventoryDollarValueBasis" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The basis for the total dollar value established by an inventory: cost, market, or other basis.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InventoryDollarValueTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value established for some collection of items by an inventory.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InventorySupervisorEntity" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The entity directing the activity of taking stock of the value of some collection of items.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InvestmentIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from interest and dividends;Schedule I field 9</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InvoluntaryBankruptcyPetitioner" type="nc:EntityType" substitutionGroup="j:CaseInitiatingParty">
		<xsd:annotation>
			<xsd:documentation>An entity which petitions the court requesting an order for relief in the form of putting another entity into bankruptcy proceedings involuntarily.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InvoluntaryBankruptcyPetitionerAttorneySignatureDate" type="nc:DateType" substitutionGroup="bkcmecf:AttorneySignatureDate">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date an attorney for a petitioner for involuntary bankruptcy signed a document.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="InvoluntaryBankruptcyPetitionerSignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date a petitioner for involuntary bankruptcy signed a document.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ItemAdditionalDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Additional description of the item like property loss or payment received.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ItemDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the property owned by debtor or gift or contributions made by the debtor, or action take by the creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ItemExistsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>A line item that exists in the current context, as reported on the Bankruptcy form. Set to 'true' if exists, or 'false' if it does not exists.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ItemFinalValueAmount" type="nc:AmountType" substitutionGroup="nc:ItemValueAmount" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The final value/balance of a sold/closed financial asset or account.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ItemNonExistencePropertyHeldForSomeoneIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>A line item that does not exist in the current case, as reported on form B107 or elsewhere in the Bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="JobOrChallengedChildEducationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount paid for education as a condition for the job or for a physically or mentally challenged dependent child.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="JudgeSignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date a judge signed a document related to a bankruptcy filing.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="JuryTrialDemandedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that someone has demanded a jury trial in a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Landlord" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person or entity who owns property and rents it out to others.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LandlordPossessingJudgmentAgainstDebtorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the landlord obtained an eviction judgment against the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LastYear" type="bkcmecf:FiscalYearType">
		<xsd:annotation>
			<xsd:documentation>Last Year Fiscal information from the financial statement.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LastYearEmploymentBusinessIncome" type="bkcmecf:DebtorEmploymentBusinessIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Employment or business income for debtor received for last calendar year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LastYearOtherIncome" type="bkcmecf:DebtorOtherIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other income for debtor received for last calendar year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LaundryExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Average dollar amount spent each month on laundry.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LeaseAssumedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the unexpired personal property lease will be assumed by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalActions" type="bkcmecf:LegalActionsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Legal actions, where debtor was a party in any lawsuit, court action, or administrative proceeding.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalActionsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor was a party in any lawsuit, court action, or administrative proceeding, within 1 year before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalConsequencesIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Debtor indicates knowledge of long term financial and legal consequences.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalDocumentsPrepared" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Legal documents prepared or caused to be prepared by the petition preparer for the bankruptcy filing.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalServicesExcludedFromAgreement" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The legal services that are specifically excluded from an agreement with a client.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalServicesFeesOthersPaid" type="bkcmecf:PetitionPreparationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A fee that was paid by someone on debtor's behalf for services for filing the bankruptcy.
case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalServicesFeesPaid" type="bkcmecf:PetitionPreparationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A fee that was paid by the debtor for services for filing the bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegalServicesFeesPromisedToPay" type="bkcmecf:PetitionPreparationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A fee promised to pay for services for filing the bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LegitimateTargetForOrderOfReliefIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates an allegation by a petitioning creditor that the debtor is a legitimate target for involuntary bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LessRecentTransfers" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Within 10 years before filing for bankruptcy, list any property transfered to a self-settled trust or device often called as asset-protection devices.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LessRecentTransfersIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if within 10 years before filing for bankruptcy, the debtor sold, traded, or otherwise transfered any property to anyone, other than property transferred in the ordinary course of your business or financial affairs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LifeInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from life insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="LowConsumerDebtsPaidIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor paid any creditor a total of $600 or more.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MandatoryRetirementPlanDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Mandatory payroll retirement plan deductions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MaritalAdjustment" type="bkcmecf:MaritalAdjustmentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Monthly expense that the debtor(s) incurred from all sources, before filing this bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MaritalAdjustmentIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A line item of a segment of income that should be excluded from section 707 b 2 consideration.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MaritalAdjustmentIncomeDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The rationale why a line item of a segment of income that should be	excluded from section 707 b 2 consideration.
			</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MaritalAdjustmentTotalIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount of debtor's income that should be excluded from section 707 b 2 consideration.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MaritalStatusCode" type="bkcmecf:MaritalStatusCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation of debtor's marital and filing status.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MarriedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is married.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MeansTestPresumptionOfAbuseCode" type="bkcmecf:MeansTestPresumptionOfAbuseCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Codes for whether the presumption of abuse arises on the means test.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MedianFamilyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Calculated median family income amount for the debtor's state and size of household. .</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MedicalDentalExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly dollar amount spent on medical and dentistry expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MemberDisabilityExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly amount debtor expends on the care and support of an elderly, chronically ill, or disabled member of your household or member of your immediate family who is unable to pay for such expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MemberNationalGuardReserveIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor is asserting eligibility for a temporary exclusion from means testing because the debtor was either a member 	of the National Guard or other Armed Forces Reserve or Homeland Security organization.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersSeniorCitizenHealthCareAllowanceAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The allowance per household member over age 65</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersSeniorCitizenHealthCareSubtotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of health care allowance for the number of members of the debtor's household over age 65</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersSeniorCitizenQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The number of members of the debtor's household over age 65</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersUnder65HealthCareAllowanceAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The allowance per household member under age 65</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersUnder65HealthCareSubtotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of health care allowance for the number of members of the debtor's household under age 65.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MembersUnder65Quantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The number of members of the debtor's household under age 65</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MonthlyCureAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly amount that must be paid to the holder of a claim in order for the debtor to maintain possession of the property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MonthlyExpense" type="bkcmecf:MonthlyExpenseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Monthly expense that the debtor(s) incurred from all sources, before filing this bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageExpense" type="bkcmecf:DebtorExpenseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A loan secured by a piece of real estate.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageHousingActualExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The actual amount the debtor expends on mortgage and housing in an average month</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageHousingNetMonthlyExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The IRS standard applicable amount for mortgage housing monthly expenses for a debtor MINUS payments for debts secured by the home.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageRentAdditionalExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Additional amount that the debtor claims, different than that the IRS Local Standard for housing is incorrect and affects the calculation of the monthly expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageRentAdditionalExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Explain the additional mortgage or rent expense amount, incurred by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="MortgageRentExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of money spent on rent or on a mortgage in a month.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureDebtorInterest" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to express the nature of the Debtor's ownership interest in a piece of property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfBusinessCode" type="bank:NatureOfBusinessCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation that describes debtor business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfDebtDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to express the nature of the Debtor's debt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfDebtsCode" type="bank:NatureOfDebtsCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code representation that describes the debts incurred by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfLienAgreementIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Check if, nature of lien is an agreement you made (such as mortgage or secured car loan)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfLienJudgmentIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Check if, nature of lien is a judgment lien from a lawsuit</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfLienOtherDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of 'Other' nature of lien.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfLienOtherIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Check if, nature of lien is a other (including a right to offset)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfLienStatutoryIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Check if, nature of lien is a statutory lien (such as tax lien, mechanic’s lien)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NatureOfSuitCode" type="bank:NatureOfSuitCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>One of a number of highly specific natures of suit, an essential taxonomy of a given lawsuit</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NewOrUpdatedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if a new creditor is added or if the information is updated from the initial submission, otherwise set to false.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonCashGovtAssistanceAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from government assistance that is not cash.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonCashGovtAssistanceDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the nature of non-cash governmental assistance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonCashGovtAssistanceIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indication of the existence of non-cash governmental assistance. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonDomiciledDependentsSupportExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An amount someone pays or is paid to financially support dependents who don't live with the payer</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonDomiciledDependentsSupportExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An explanation of the amount someone pays or is paid to financially support dependents who don't live with the payer.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonDomiciledDependentsSupportIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indication of the existence of payments to financially support dependents who don't live with the payer.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonIndividualBankruptcyPetition" type="bkcmecf:NonIndividualBankruptcyPetitionType" substitutionGroup="bkcmecf:BankruptcyPetition" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Information needed to initiate bankruptcy cases.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonPriorityClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The portion of the nonpriority amount as part of the total unsecured claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonPriorityUnsecuredClaimCode" type="bank:NonPriorityUnsecuredClaimCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding a code type of NONPRIORITY unsecured claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonPriorityUnsecuredClaims" type="bkcmecf:UnsecuredClaimsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>NonPriority unsecured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NonPriorityUnsecuredClaimsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if any creditors have nonpriority unsecured claims against the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NotifyOthersIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if other entities exist to be notified of the secured debt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="NotPayingDebtsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates an allegation by a petitioning creditor that the debtor is not paying his debts.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OperateBusinessIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor operates a business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OperatingBusinessIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor have income from operating a business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OriginalBankruptcyCase" type="j:CaseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element to hold any prior Bankruptcy cases in which an adversarial proceeding arises.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherClaimDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of 'Other' unsecured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherContributionsReceivedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Contributions received towards costs associated with maintaining a household</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherContributionsReceivedDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of contributions received towards costs associated with maintaining a household</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherContributionsReceivedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indication of the existence of contributions to financially support a debtor household.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Any other payroll deduction listed on Schedule I field 4.d</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherDeductionDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Specification of the other payroll deduction listed on Schedule I field 4.d</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A catch-all category for other monthly household expenses on schedule J</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A textual explanation of a specific household expense that fell into the catch-all category on schedule J</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherExpenseTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of other miscellaneous average monthly expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from other sources</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherIncomeDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Specification of the income from other sources listed</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor have received any other income during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherIncomeSourceDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A textual explanation of other source of income received by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherIncomeTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total of all other sources of debtor or debtor spouse's Income from otherwise unspecified sources.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherInstallmentPaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from a type of installment payment expense not listed on schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherInstallmentPaymentsExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the monthly expense from a type of installment payment expense not listed on Schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The monthly expense from a type of insurance expense not listed on schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherInsuranceExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of a type of insurance expense not listed on schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherPersonalProperty" type="bkcmecf:OtherPersonalPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of other property of any kind not listed else where on schedule A/B.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealEstateItem" type="bkcmecf:PropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of other real estate property in a form not otherwise specified.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealPropertyHomeownersAssociationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The costs arising from non-debtor home owner's association or condominium dues.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealPropertyHomeownersRentersInsuranceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of monthly expense for renters or homeowners insurance for a nonresidential piece of real estate.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealPropertyMaintenanceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The costs arising from physically maintaining a house or other dwelling that is not the debtor's residence.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealPropertyMortgageExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The amount of money spent on rent or on a mortgage for a nonresidential piece of real estate in a month.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRealPropertyRealEstateTaxesExpenseAmount" type="nc:AmountType">
		<xsd:annotation>
			<xsd:documentation>Real estate taxes not included in the reported rent or home mortgage payment for a nonresidential piece of real estate listed on the schedule.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherRecentResidenceIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>True if lived anywhere in past three years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OtherSecuredDebts" type="bkcmecf:DebtorExpenseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other debts that are secured by an interest in property owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OthersNotified" type="bkcmecf:OthersNotifiedType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List of others to be notified for a debt, that was listed in the secured claim section.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OthersNotifiedLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Others notified of the secured debt line number (ex. 3.1, 3.2, …)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OvertimeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Individual's estimate of their monthly overtime amount</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OwnershipInterestCode" type="bkcmecf:OwnershipType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The code type that a property is owned.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OwnershipInterestDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The code type that a property is owned.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OwnershipNatureOfInterest" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The nature of some entity's ownership interest in something. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="OwnershipPercentage" type="nc:PercentageType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The percentage of some entity's ownership interest in something. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaidLandlordEntireAmountIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that the debtor paid the landlord entire amount owed as stated on judgment for possession.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PayerIsDebtorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator whether a payment is made by the debtor or some other entity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentCode" type="bkcmecf:PaymentType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The code type that a payment was made against.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The date a payment was made to a creditor or an insider.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description or reason for which the payment was made to the insider or a creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentIncludesTaxesInsuranceIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if a payment to a creditor includes taxes or insurance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentsTransfersConsulted" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payments or transfers consulted by debtor or anyone else acting on their behalf for preparing a bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentsTransfersConsultedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor or anyone else acting on their behalf made payments or transfer any property to anyone, the debtor consulted about seeking bankruptcy or preparing a bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentsTransfersPromised" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payments or transfers promised by debtor or anyone else acting on their behalf for preparing a bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PaymentsTransfersPromisedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor or anyone else acting on their behalf made payments or transfer any property to anyone, who promised to help debtor deal with creditors or to make payments to creditors.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PayNonAttorneyIndicator" type="bkcmecf:IndicatorType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor agrees to pay someone who is not an attorney to help fill out bankruptcy forms.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PayPetitionPreparerIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor paid or agree to pay someone who is not an attorney to help fill out bankruptcy forms.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PayrollDeduction" type="bkcmecf:PayrollDeductionType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Instance of an individual's various payroll deductions;</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PayrollNetIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Monthly net take home salary amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PendingAffiliatedCase" type="j:CaseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold any existing pending affiliated cases to the one currently referenced.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PendingBankruptcyCase" type="j:CaseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold any prior Bankruptcy cases filed by the same debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PendingBankruptcyCaseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator whether a pending bankruptcy case or being filed against the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PensionRetirementIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from a pension or retirement income</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PersonAgeInYearsQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Age of a person in years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PersonalServicesExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Monthly expenses for personal care products and services.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionerClaimsTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of the values of the claims of the petitioning creditors in an involuntary bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionerCorporationAuthorizedIndividual" type="nc:EntityType" substitutionGroup="bkcmecf:CorporationAuthorizedIndividual">
		<xsd:annotation>
			<xsd:documentation>An individual allowed to represent a corporate debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionFilingFee" type="bkcmecf:PetitionFilingFeeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A fee charged by the court for the filing of a petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionPreparer" type="bkcmecf:PetitionPreparerType" substitutionGroup="nc:ObligationRecipient" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A person who collects fees for preparing documents for debtors filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionPreparerRoleCode" type="bkcmecf:PetitionPreparerRoleCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code categorizing a person who collects fees for preparing documents for debtors filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionPreparerRoleDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description categorizing a person who collects fees for preparing documents for debtors filing for Bankruptcy.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PetitionPreparerSignatureDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A element indicating the date the Petition Preparer of the debtor signed their petition for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PlaintiffPartyRoleCode" type="bkcmecf:PartyRoleCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A categorization of a plaintiff in a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PlanAcceptedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An element for indicating whether a plan has been accepted in a Chapter 11.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PreemptivePresumptionDeterminationCode" type="bkcmecf:PreemptivePresumptionDeterminationCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code for whether or not presumption of abuse arises determined in the means test forms.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PreparationFeePaymentFreezeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a judge has ordered the debtor to pay no more fees to attorney or petition preparer until the
				debtor has completed the installment payments of the Bankruptcy petition.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PresumptionOfAbuseCode" type="bkcmecf:PresumptionOfAbuseCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Enumeration of allowed values of the Presumption of Abuse of Bankruptcy chapter 7.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PrimarilyConsumerDebtsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor asserts that their debts are primarily consumer debts in origin.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorAddressDetails" type="bkcmecf:PriorAddressDetailsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A set of data about prior addresses of the debtor, as reported on financial statement form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorAddressIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor(s) have lived anywhere other than the current address, during the last 3 years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorBankruptcyCaseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor had a prior Bankruptcy case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorBankruptcyCaseItem" type="j:CaseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold any prior Bankruptcy cases filed by the same debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The portion of the priority amount as part of the total unsecured claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimDebtOwner" type="bkcmecf:OwnershipType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Who incurred the debt?  - valid values are</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimsMonthlyPastDueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total amount of all past-due priority claims divided by 60, representing the monthly payment over the term of five years.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimsTaxesTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar amount of unsecured claims entitled to priority.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimsTotalPastDueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total amount of all past-due priority claims. 	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityClaimTotalClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar amount of unsecured claims entitled to priority.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityNonPriorityClaimsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if debtor owe creditors priority claim amount. Set to false if owe non-priority claim amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityUnsecuredClaimCode" type="bank:PriorityUnsecuredClaimCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for holding a code type of PRIORITY unsecured claim.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityUnsecuredClaims" type="bkcmecf:UnsecuredClaimsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold any priority unsecured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorityUnsecuredClaimsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if any creditors have priority unsecured claims against the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorLastYear" type="bkcmecf:FiscalYearType">
		<xsd:annotation>
			<xsd:documentation>Prior last year fiscal information from the financial statement.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorLastYearEmploymentBusinessIncome" type="bkcmecf:DebtorEmploymentBusinessIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Employment or business income for debtor received for prior last calendar year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorLastYearOtherIncome" type="bkcmecf:DebtorOtherIncomeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other income for debtor received for prior last calendar year.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PriorYear" type="bkcmecf:FiscalYearType">
		<xsd:annotation>
			<xsd:documentation>Prior Year Fiscal information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ProjectedMonthlyPaymentPlanAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The projected average monthly amount debtor would pay under a chapter 13 payment plan.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ProjectedMonthlyPaymentPlanMultiplier" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The multiplication factor to be applied to the projected average monthly amount debtor would pay under a chapter 13 payment plan, according to the debtor's judicial district.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyAccessHavingEntity" type="nc:EntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An entity other than the owner of property which had access to the property.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyAccountsReceivableItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of accounts receivable.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyAnnuitiesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of annuities.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyBankAccountItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of personal property consisting of a checking or savings or other type of account at a bank, thrift, or credit union.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyBondsSecuritiesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of bonds or negotiable paper or other non-stock securities.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyBusinessPartnershipInterestsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of an ownership interest in a business partnership or joint venture.
			</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCashOnHandItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of personal property consisting of cash on hand.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCategoryCode" type="bkcmecf:PropertyType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The code type that a piece of property is categorized into.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyClothingItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of clothing.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCollectiblesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of books, art, antiques, or collectibles.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCoveredByExemptionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator debtor acquire the property covered by the exemption within 1,215 days before you filed this case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCropsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of agricultural crops.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCurrentValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The current value of the property (entire property) owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyCustomerListsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of customer lists.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyDueItem" type="nc:ObligationType">
		<xsd:annotation>
			<xsd:documentation>An item to hold data of Money or property due to the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyEducationIRAItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of an education IRA.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyElectronicsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of electronic goods. Ex:Televisions and radios, digital equipment, electronic devices.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyExemptClaimSet" type="bkcmecf:PropertyExemptClaimSetCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to express the category of Debtor's interest in a piece of property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyFamilySupportItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of alimony or some kind of legal support settlement.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyFarmAnimalsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of an farm animals:Livestock, poultry, farm-raised fish.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyFarmingEquipmentItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of farming equipment.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyFarmingSuppliesChemicalsFeedItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of farming supplies, fertilizer, or feed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyFirearmsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of firearms.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyGroundMotorVehicles" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of cars, trucks, or other land motorized vehicles.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyHeldOrControlled" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor hold or control any property that someone else owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyHeldOrControlledIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor hold or control any property that someone else owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyHouseholdGoodsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of household goods. Ex:Major appliances, furniture, linens, china, kitchenware.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyInsurancePoliciesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of an insurance policy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyIntentionCode" type="bank:PropertyIntentionCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Intention code type of the property that secures a debt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyInventoryItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of business inventory.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItem" type="bkcmecf:PropertyItemType" substitutionGroup="bkcmecf:PropertyItemRepresentation">
		<xsd:annotation>
			<xsd:documentation>A generic item of property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItemClaimedAsExemptIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a given property item is claimed as exempt by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItemDetails" type="bkcmecf:PropertySetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of cars, trucks, or other land motorized vehicles.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItemLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Multiple Properties owned by the debtor line number</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItemReference" type="s:ReferenceType" substitutionGroup="bkcmecf:PropertyItemRepresentation">
		<xsd:annotation>
			<xsd:documentation>A reference to a piece of Property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyItemRepresentation" abstract="true">
		<xsd:annotation>
			<xsd:documentation>An abstract item of property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyJewelryItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of jewelry: engagement rings, wedding rings, heirloom jewelry, watches, gems, gold, silver.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyLicensesFranchisesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of licenses, franchises, or other intangibles.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyLifeInsuranceDeathBenefitsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of life insurance or other death benefits.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyMachineryFixturesEquipmentSuppliesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of business machinery.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyNonfarmAnimalsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of an non-farm animals:Dogs, cats, birds, horses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOfficeEquipmentItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of office equipment.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherBusinessAssetsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other business assets not already listed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherContingentClaimsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other contingent unliquidated claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherFarmingAssetsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other farming assets not already listed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherFinancialAssetsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other financial assets not already listed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherInformation" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Other information you wish to add about this item, such as local property identification number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in a form not otherwise specified.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherLoansOwedItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other loans owed to the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOtherPersonalAssetsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of other personal assets not already listed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOwedCurrentValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The current value of the portion of the property owed to the debtor or the debtor owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyOwnedCurrentValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The current value of the portion of the property owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyPartnershipJointVenturesInterestsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form an ownership interest in a partnership or joint ventures.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyPatentsCopyrightsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of patents, copyrights, or other intellectual property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyPossessionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debot's property was in the possession of an assignee for the benefit of creditors, a court-appointed receiver, a custodian, or another official.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyRetirementPensionItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of pension or IRA, or a retirement or profit-sharing plan.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertySavingsAccountItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of personal property consisting of a savings account at a bank, thrift, or credit union.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertySecuritiesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of publicly traded stocks, mutual funds and  bonds.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertySecurityDepositItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of personal property in the form of a security deposit.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertySportsHobbiesItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of sports and hobbies equipment.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyTaxRefundsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of liquidated debts owed to the person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyThirdPartyClaimsItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of claims against third parties.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyTrustEquitableInterestItem" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of legal interests granted to the person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyValue" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The value of the property owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyVehicle1Item" type="bkcmecf:PropertyVehicleItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of: Cars, 	vans, trucks, sports utility vehicles, motorcycles, tractors, boats, etc.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyVehicle2Item" type="bkcmecf:PropertyVehicleItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of: Cars, 	vans, trucks, sports utility vehicles, motorcycles, tractors, boats, etc.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyVehicleItem" type="bkcmecf:PropertyVehicleItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of: Cars, 	vans, trucks, sports utility vehicles, motorcycles, tractors, boats, etc.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="PropertyWaterAirRecreationalVehicles" type="bkcmecf:PropertyItemSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item personal property in the form of ships, 	boats, and related nautical equipment and accessories.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ProtectionAgainstFamilyViolenceExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The average monthly amount debtor expends to maintain the safety of their family under the Family Violence Prevention and Services Act or other applicable federal law.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealEstateExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The business expenses from ordinary and necessary operation of a rental or other source of real property income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealEstateIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Regular income from real property</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealEstateNetIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The debtor or debtor spouse's Income net of Expenses attendent to deriving income from real property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealEstateProperty" type="bkcmecf:RealEstatePropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of real estate property such as Residence, Building, Land, or Other Real Estate.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealEstateTaxesExpenseAmount" type="nc:AmountType">
		<xsd:annotation>
			<xsd:documentation>Real estate taxes, if taxes are not included in the reported rent or home mortgage payment.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealPropertyCommunityIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that a piece of property is a community property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealPropertyLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Real property line number</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RealPropertyOwnership" type="bkcmecf:OwnershipType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The code type that a property is owned.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReceivePropertyDueDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of why payment for a debt or debts is expected by the recipient within 180 days. </xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReceivePropertyDueIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor will likely receive payment in the next 180 days</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RecentTransfers" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Within 2 years before filing for bankruptcy, list property sold, traded, or otherwise transfered to anyone.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RecentTransfersIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if within 2 years before filing for bankruptcy, the debtor sold, traded, or otherwise transfered any property to anyone, other than property transferred in the ordinary course of your business or financial affairs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RecreationEntertainmentExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent on recreation and entertainment in an average month.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReleasedFromActiveDutyDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Date the debtor who became either a member of the National Guard	or other Armed Forces Reserve or Homeland Security duty after 9/11 for a period of at least 90 days was released from active duty, which is less than 540 days prior to filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReleasedFromActiveDutyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor who was either a member of the National Guard or other Armed Forces Reserve
				after 9/11 was released from active duty less than 540 days prior to filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReliefDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The outcome from the court desired by a litigant.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RemainOnActiveDutyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor who was either a member of the National Guard or other Armed Forces Reserve after 9/11 remains on active duty.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RepossessedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if  debtor's property was repossessed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Repossession" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Act of property being sized from debtor by a creditor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RepossessionIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if  debtor's property was repossessed, foreclosed, garnished, attached, seized, or levied, within 1 year before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RequestForRelief" type="bkcmecf:RequestForReliefType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Petitioners request that an order for relief be entered against the debtor under the chapter specified.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RetirementPlanDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A deduction from debtor's income for qualified retirement plan.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RetirementPlanLoanRepaymentDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A deduction from debtor's income for repayment of a self-loan from a qualified retirement plan.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RightToStayIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator that the debtor has right to stay in the residence by paying the landlord the entire delinquent amount.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SafeDepositBoxes" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List any safe deposit box or other depository for securities, cash, or other valuables, that the debtor now have, or had within 1 year before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SafeDepositBoxesIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor now have, or had any safe deposit box or other depository for securities, cash, or other valuables.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SameAddressIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor2 prior address is same as debtor1.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SameDateRangeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor2 prior address date range is same as debtor1.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleABLineItem" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Line item number from Schedule A/B.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleDIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the creditor to whom the debtor owe the debts exists on Schedule D.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleDLineItem" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Line item number from Schedule D.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleEFIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the creditor to whom the debtor owe the debts exists on Schedule D.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleEFLineItem" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Line item number from Schedule E/F.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleGIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the creditor to whom the debtor owe the debts exists on Schedule D.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ScheduleGLineItem" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Line item number from Schedule G.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecondaryPresumptionDeterminationCode" type="bkcmecf:MeansTestPresumptionOfAbuseCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Codes for whether the presumption of abuse arises under the second bite of the apple in the means test.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold the value of a secured portion of a given legal claim against the Debtor's estate.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimAmountPlanLimitsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates that the Chapter 13 Plan seeks to limit the amount of a secured claim</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaims" type="bkcmecf:SecuredClaimsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Representation of  Claims secured by the debtor's property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>An indicator that creditors exist holding secured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimsLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Creditor holding secured claim line number (ex. 2.1, 2.2, …)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimsPageSubTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monetary value of all creditors' secured claims on a given page of the form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimsUnsecuredPortionsPageSubTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monetary value of the unsecured portions of all creditors' secured claims on a given page of the form.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredClaimsUnsecuredPortionsTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monetary value of the unsecured portions of all creditors' secured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SecuredDebtsForSupport" type="bkcmecf:DebtorExpenseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debts that are secured by primary residence, vehicle, necessary for debtor's support.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ServicesWaiverDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of special circumstances excusing why a debtor has not yet undergone credit Counseling though filing for Bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SetoffIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if any creditor  set off any amounts from the debtor's accounts or refuse to make a payment because of a owed debt.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ShellCompanyIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true' if the debtor is a shell company as defined in the Securities Exchange Act of 1934 Rule 12b-2.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SmallBusinessIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor business qualifies as a small business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SoleProprietor" type="bkcmecf:SoleProprietorType">
		<xsd:annotation>
			<xsd:documentation>An element to store debtor sole proprietor details of any full or part-time business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SoleProprietorIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor is a sole proprietor of any full- or part-time business.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpecialCircumstanceDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A deduction from debtor's income based on a specified special circumstance.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpecialCircumstanceDeductionDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A specification of the reason for a deduction from debtor's income based on a special circumstance.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpecialCircumstanceDeductionTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount of all special circumstance deductions from debtor's income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpecialCircumstanceIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicates whether the debtor alleges any special circumstances that justify additional expenses or adjustments of current monthly income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpecialCircumstances" type="bkcmecf:SpecialCircumstanceType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Special circumstances justify additional expenses and have no reasonable alternative.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SpouseIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if debtor spouse is a member of the family.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StandardInsuranceOperatingExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The IRS standard applicable amount listed for debtor's county for insurance and operating expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StandardMortgageRentExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The IRS standard amount for mortgage or rent expenses for a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StandardPublicTransportationExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The standard public transportation amount allowed the IRS LOCAL standards.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StandardVehicleOperatingCostsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The standard allowance for vehicle operation according to IRS standards for the debtor</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StatementLeaseEntity" type="bkcmecf:StatementLeaseEntityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A legally enforceable agreement whereby one or more entities who are parties agree to take some action in return for consideration.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StatementSecuredClaims" type="bkcmecf:StatementSecuredClaimsType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Representation of  Claims secured by the debtor's property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StatisticallyTrackedLiabilitiesTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A sum of various types of liabilities specifically tracked on schedule J.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StockCommonSharesQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Some quantity of common shares issued by some company.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StockPreferredSharesQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Some quantity of preferred shares issued by some company.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StorageUnits" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>List any storage units or place other than home that the debtor stored property, within 1 year before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StorageUnitsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true if the debtor stored property in a storage unit, within 1 year before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Subchapter" type="bkcmecf:SubchapterType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code that represents subchapter for a case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SubstantiveIssueOfStateLawExistsIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>True if it is asserted that a substantive issue of state law exists in a given case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SupplementFormEffectiveDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A supplement showing post petition chapter 13 income/expenses as of the following date.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="SupplementFormFilingIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to 'true'  if a supplement showing post-petition chapter 13 income/expenses is filed.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TaxesNotWithheldExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount of taxes not deducted from pay or rental or real property expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TaxesNotWithheldExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A specification of taxes not deducted from wages or included in home mortgage payments.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TaxMedicareSocialSecurityDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payroll taxes, Medicare and social security deductions amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TelecomExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total monthly amount debtor expends on telecommunication services other than basic home telephone and cell phone service.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalAllowedDeductionsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total of all deductions from income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalBusinessPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all business property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalClaimedExemptionsValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum total value of all the portions of items of property of debtor1 and debtor2 that are claimed as exempt from the bankruptcy pool of assets.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCureAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount that must be paid to the holder of a claim in order for the debtor to maintain possession of the property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCurrentMonthlyIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The TOTAL of debtor1 and debtor2 current monthly income amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCurrentValueFinancialAssetsOwnedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total current value of the portion for all the financial assets, owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCurrentValueHouseholdItemsOwnedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total current value of the portion for all the personal and household items, owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCurrentValueRealEstateOwnedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total current value of the portion for all the real estate, owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalCurrentValueVehiclesOwnedAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total current value of the portion for all the vehicles, owned by the debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalDeathClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Priority Unsecured Claims: Claims for death or personal injury while you were intoxicated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalDebtPaymentsDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Deductions from debtor income for debt payments.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalDomesticSupportObligationAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Priority Unsecured Claims: Total Domestic support obligations claim amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalExpectedPaymentOnSecuredClaimsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total expected payment on secured claims amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalFarmingPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all farming and fishing related property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalFinancialPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all financial assets belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalHouseholdDependents" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The number of dependents in the debtor's household.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalIndependentIncomeAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Schedule I (Income) Debtor1/Debtor2 Total of all other income regularly received.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalIRSStandardAllowableExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total amount allowed under IRS standards for the means test</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalLiabilitiesAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum of liabilities on the summary of schedules.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalMonthlyCurePaymentAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total amount that the debtor must pay to a creditor, in addition to secured debts payments, in order to keep possession of the property (called the cure amount).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalMonthlyExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Debtor1/Debtor2 total monthly expenses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalNonPriorityUnsecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all  non-priority unsecured claims reported on Schedule E/F.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalObligationAgreementAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Nonpriority Unsecured Claims: Obligations arising out of a separation agreement or divorce that you did not report as priority claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalOtherNonPriorityClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total Other claim amount. Add all other nonpriority unsecured claims amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalOtherPersonalPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all other personal property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalOtherPriorityClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Priority Unsecured Claims: Other. Add all other priority unsecured claims amount.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPaymentAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total amount paid by the debtor to a creditor, before filing for bankruptcy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPayrollDeductionsAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Total payroll deductions on the income schedule.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPensionDebtAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar amount of some pension obligations.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPersonalPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all items of personal property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPriorityUnsecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all priority unsecured claims reported on Schedule E/F.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all real property and personal property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalRealPropertyValueAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of all real property belonging to a debtor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalSecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar value of creditors' secured claims.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalStudentLoanAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Nonpriority Unsecured Claims: The total dollar amount of a debtor's student loan obligation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalTaxesDebtAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Priority Unsecured Claims: Total Taxes and certain other debts that the debts owe the government.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TotalUnsecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The sum total amount of all unsecured priority and non-priority claims reported on Summary of Schedules.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TransportationNonInstallmentPaymentsExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent on non-installment expenses in an average month.	</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnemploymentCompensationAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The debtor or debtor spouse's Income from Unemployment compensation NOT a benefit under the Social Security Act.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnemploymentCompensationSSAAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The debtor or debtor spouse's Income from Unemployment compensation, received as a benefit under the Social Security Act.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnionDuesDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Payroll union dues deductions; Schedule I field 4.c</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnsecuredClaimAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element to hold the value of a unsecured portion of a given legal claim against the Debtor's property.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnsecuredClaimsLineNumber" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Creditor holding unsecured claim line number (ex. 2.1, 2.2, …)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UnsecuredClaimsNotEntitledPriorityTotalAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total dollar amount of unsecured claims NOT entitled to priority.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UtilitiesElectricFuelExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent on heat and electricity expenses in an average month.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UtilitiesOtherExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent in an average month on some specific other utilities.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UtilitiesOtherExpenseDescription" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of a type of monthly utility expense not otherwise covered by the categories listed on the means test.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UtilitiesTelephoneExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent on telephonic and other telecommunications expenses in an average month (part of means test calculation).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="UtilitiesWaterSewerExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Amount debtor spent on water and sewer utilities in an average month (part of means test calculation).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Vehicle1OwnershipLeasingNetExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The net expense of owning the debtors vehicle 1 on the means test</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Vehicle2OwnershipLeasingNetExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The net expense of owning the debtors vehicle 2 on the means test</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleApproximateMileageQuantity" type="niem-xsd:integer" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Approximate reading of a vehicle odometer to the nearest mile.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleLoan" type="bkcmecf:DebtorExpenseType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A loan secured by a vehicle.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleMake" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A manufacturer of a vehicle.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleModel" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A specific design or class of vehicle made by a manufacturer.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleOwnershipLeasingExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Vehicle ownership or lease expense: Ownership or leasing costs using IRS Local Standard.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehiclesProperty" type="bkcmecf:VehiclesPropertyItemType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An item of vehicles property that the debtor owns.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VehicleTotalMonthlyPaymentExpenseAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>The total average monthly payments for all vehicular expenses of a debtor</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ViolationNotified" type="bkcmecf:FinancialActivityType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Any governmental unit notified that the debtor may be liable or potentially liable under or in violation of an environmental law.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ViolationNotifiedIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if any governmental unit notified that the debtor may be liable or potentially liable under or in violation of an environmental law.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="VoluntaryRetirementPlanDeductionAmount" type="nc:AmountType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Voluntary payroll retirement plan deductions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="WagesCommissionsIncomeIndicator" type="bkcmecf:IndicatorType" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Indicator set to true, if the debtor have wages, commissions, bonuses or tips income.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="AccountCodeType">
		<xsd:annotation>
			<xsd:documentation>Specific values for category of account types.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:AccountSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="AliasCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of aliases.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:AliasCategorySimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="AliasType">
		<xsd:annotation>
			<xsd:documentation>A data type for aliases</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="nc:PersonNameType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:AliasTypeCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="BankruptcyFormType">
		<xsd:annotation>
			<xsd:documentation>The base type for all forms used in Bankruptcy Case Filing using NIEM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="nc:DocumentType">
				<xsd:sequence>
					<xsd:element ref="j:CaseCourt" minOccurs="0"/>
					<xsd:element ref="nc:CaseTitleText" minOccurs="0"/>
					<xsd:element ref="nc:CaseDocketID" minOccurs="0"/>
					<xsd:element ref="nc:CaseTrackingID" minOccurs="0"/>
					<xsd:element ref="bkcmecf:FormAmendedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:BankruptcyChapter" minOccurs="0"/>
					<xsd:element ref="j:CaseInitiatingParty" minOccurs="0" maxOccurs="2"/>
					<xsd:element ref="j:CourtEventSequenceID" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
		<!-- court in which the case is filed in
			the debtor if applicable; "In re:" (case short title)
			<xsd:element ref="nc:RoleOfPersonReference" minOccurs="0" maxOccurs="1"/>
			the case number if known
			internal cmecf caseid
			de_seqno -->
	</xsd:complexType>
	<xsd:complexType name="BankruptcyPetitionSetType">
		<xsd:annotation>
			<xsd:documentation>A data type for a collection of Bankruptcy Petitions, for hypothetical reporting purposes.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="bkcmecf:BankruptcyFormType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:BankruptcyPetition" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="BankruptcyPetitionType" abstract="true">
		<xsd:annotation>
			<xsd:documentation>The root element for Bankruptcy Case Filing using NIEM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="bkcmecf:BankruptcyFormType">
				<xsd:sequence>
					<xsd:element ref="nc:ApplicationName"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="BusinessPropertyItemType">
		<xsd:annotation>
			<xsd:documentation>A data type for an item of business related property belonging to a debtor in Bankruptcy.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:ItemExistsIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyAccountsReceivableItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyOfficeEquipmentItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyMachineryFixturesEquipmentSuppliesItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyInventoryItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyPartnershipJointVenturesInterestsItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyCustomerListsItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyOtherBusinessAssetsItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:TotalBusinessPropertyValueAmount" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CaseStatusCodeType">
		<xsd:annotation>
			<xsd:documentation>Specific values for category of case status.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:CaseStatusSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="ChangeInIncomeExpenseExpectedType">
		<xsd:annotation>
			<xsd:documentation>Change in Income or Expenses</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:ChangeInIncomeExpenseIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:IncomeExpenseLineNumber" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ChangeInIncomeExpenseDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:DateText" minOccurs="0"/>
					<xsd:element ref="bkcmecf:IncreaseOrDecreaseExpectedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ChangeInIncomeExpenseAmount" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="ClaimType">
		<xsd:annotation>
			<xsd:documentation>Data types for claims of creditors against debtors.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CreditorRepresentation" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CoDebtorIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimIncurredDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimNatureDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimConsiderationDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyItemRepresentation" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimContingentIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimUnliquidatedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimDisputedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimOtherIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimLienIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimSecurityAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:UnsecuredClaimAmount" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CoDebtorEntityType">
		<xsd:annotation>
			<xsd:documentation>A data type for the association of co-debtors on Schedule H.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CoDebtorLineNumber" minOccurs="0"/>
					<xsd:element ref="bkcmecf:NewOrUpdatedIndicator"/>
					<xsd:element ref="bkcmecf:CoDebtor" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleDIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleDLineItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleEFIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleEFLineItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleGIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ScheduleGLineItem" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="ContractLeaseEntityType">
		<xsd:annotation>
			<xsd:documentation>A data type for a legally enforceable arrangement whereby at least one party agree to take or refrain from specified actions in exchange for some consideration.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:ContractLeaseLineNumber" minOccurs="0"/>
					<xsd:element ref="bkcmecf:NewOrUpdatedIndicator"/>
					<xsd:element ref="bkcmecf:ContractPartyRepresentation" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ContractDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ItemDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:LeaseAssumedIndicator" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="ContractPartyAssociationType">
		<xsd:annotation>
			<xsd:documentation>A data type for an association between a Contract and a Contract Party.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="nc:AssociationType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:ContractReference" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="nc:PersonReference" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="nc:OrganizationReference" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="ContractType">
		<xsd:annotation>
			<xsd:documentation>A data type for a legally enforceable arrangement whereby at least one party agree to take or refrain from specified actions in exchange for some consideration.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:ContractLeaseLineNumber" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractPartyRepresentation" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractIdentification" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractDescription" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractNatureDebtorInterest" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractNonresidentialRealPropertyLeaseIndicator" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractEffectiveDate" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:ContractEndDate" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CreditCounselingCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of credit counseling type</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:CreditCounselingSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="CreditCounselingType">
		<xsd:annotation>
			<xsd:documentation>Debtor's effort to receive a briefing about credit counseling.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CreditCounselingCode" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ServicesWaiverDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:BriefingNotRequiredReasonCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of creditors.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:CreditorCategorySimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorDetailsType">
		<xsd:annotation>
			<xsd:documentation>Representation of creditors in a bankruptcy case.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:NewOrUpdatedIndicator"/>
					<xsd:element ref="bkcmecf:Creditor" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorEntityIndividualCodeType">
		<xsd:annotation>
			<xsd:documentation>Indicates whether a creditor is an individual or an organization.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bkcmecf:CreditorEntityIndividualSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorMatrixType">
		<xsd:annotation>
			<xsd:documentation>Representation of creditors in a bankruptcy case.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="bkcmecf:BankruptcyFormType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CreditorDetails" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorPaymentType">
		<xsd:annotation>
			<xsd:documentation>A data type on Statement of Affairs, prior payments by debtor to creditors.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CreditorReference" minOccurs="0"/>
					<xsd:element ref="nc:ActivityDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CreditorPaymentAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:DomesticSupportPaymentIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PaymentIncludesTaxesInsuranceIndicator" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="CreditorType">
		<xsd:annotation>
			<xsd:documentation>A data type for some entity playing the role of a creditor in a bankruptcy case.</xsd:documentation>
			<!-- cr_id unknow if this is an insert or user supplied so optional
		cr_caseid pointer to the case this creditor is associated with
		cr_num=pointer to the person or organization that is assuming the role of Creditor
		cr_num=pointer will obtain access to cr_name, cr_address1-5, cr_zip
		cr_type code that identifies the type of creditor
		cr_committee_flag indicates if this creditor is member of a creditor committee
		cr_date_start
		cr_date_end
		cr_addressflag
		cr_entity_indiv will be determined by which type of reference, RoleOfPerson or RoleOfOrganization
		pointer to claims NOT IN TABLE BUT USEFUL
		account number of debtor with this Creditor NOT IN TABLE-->
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="nc:OrganizationType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:CreditorID" minOccurs="0"/>
					<xsd:element ref="nc:CaseReference" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="nc:RoleOfPersonReference" minOccurs="0"/>
					<xsd:element ref="nc:RoleOfOrganizationReference" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CreditorCategoryCode" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:CreditorCommitteeMemberIndicator" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:CreditorStartDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CreditorEndDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CreditorAddressOverideIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CreditorEntityIndividualCode" minOccurs="0"/>
					<xsd:element ref="j:ActivityCaseAssociationReference" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:AccountNumber" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:DebtorRelationshipDescription" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorEmploymentBusinessIncomeType">
		<xsd:annotation>
			<xsd:documentation>A data type for debtors employment or business income during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="nc:CaseYearDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:Debtor1Income" minOccurs="0"/>
					<xsd:element ref="bkcmecf:Debtor2Income" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorEmploymentType">
		<xsd:annotation>
			<xsd:documentation>A data type container referencing debtors employment information.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:EmploymentStatusIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:EmploymentDetails" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorExemptPropertyType">
		<xsd:annotation>
			<xsd:documentation>Representation of Bankruptcy form B106C, Schedule C, using NIEM.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="bkcmecf:BankruptcyFormType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:PropertyExemptClaimSet" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ExemptProperty" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element ref="bkcmecf:HomesteadExemptionIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyCoveredByExemptionIndicator" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorExpenseType">
		<xsd:annotation>
			<xsd:documentation>A data type for certain expenses like mortgage, rent, debt payment incurred by the debtor.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="nc:OrganizationName" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyItem" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PaymentIncludesTaxesInsuranceIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:AverageMonthlyPaymentAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:TotalCureAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:MonthlyCureAmount" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorIncomeType">
		<xsd:annotation>
			<xsd:documentation>A data type container referencing debtors employment or business income during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
					<xsd:element ref="bkcmecf:WagesCommissionsIncomeIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:OperatingBusinessIncomeIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:GrossIncomeAmount" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorOtherIncomeType">
		<xsd:annotation>
			<xsd:documentation>A data type container referencing debtors other income received during this year or the two previous calendar years.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ComplexObjectType">
				<xsd:sequence>
