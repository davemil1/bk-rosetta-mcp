					<xsd:element ref="bkcmecf:ItemDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PropertyIntentionCode" minOccurs="0"/>
					<xsd:element ref="nc:ItemDescriptionText" minOccurs="0"/>
