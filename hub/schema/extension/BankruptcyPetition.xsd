	<xsd:simpleType name="CreditCounselingSimpleCodeType">
		<xsd:annotation>
			<xsd:documentation>Valid reason codes if the debtor(s) have received a briefing about credit counseling.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>Certification received - debtor has received a certificate of completion from an accredited credit Counseling agency.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>Certification not received - debtor asserts that they have undergone credit counseling, but have not yet gotten their official certificate.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>Services waiver requested - debtor request a waiver asserting special circumstances, was unable to obtain those services.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation>Briefing not required - debtor asserts that they are not required to receive a briefing about credit counseling.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
