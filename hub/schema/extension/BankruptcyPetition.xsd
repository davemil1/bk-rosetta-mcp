		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="p">
				<xsd:annotation>
					<xsd:documentation>Pending</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="o">
				<xsd:annotation>
					<xsd:documentation>On appeal</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="c">
				<xsd:annotation>
					<xsd:documentation>Concluded</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
