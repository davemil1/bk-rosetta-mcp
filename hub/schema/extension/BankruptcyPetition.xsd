			<xsd:documentation>The presumption of abuse on the means test.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="n">
				<xsd:annotation>
					<xsd:documentation>There is no presumption of abuse.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="d">
				<xsd:annotation>
					<xsd:documentation>The calculation to determine if a presumption of abuse applies will be made under Chapter 7 Means Test Calculation.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="PresumptionOfAbuseSimpleCodeType">
		<xsd:annotation>
			<xsd:documentation>The presumption of abuse on the means test.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="n">
				<xsd:annotation>
					<xsd:documentation>There is no presumption of abuse.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="d">
				<xsd:annotation>
					<xsd:documentation>The calculation to determine if a presumption of abuse applies will be made under Chapter 7 Means Test Calculation.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
