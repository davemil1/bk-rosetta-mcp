				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="o">
				<xsd:annotation>
					<xsd:documentation>The provider of services in a Bankruptcy case was of some other type.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
