					<xsd:element ref="bkcmecf:CreditorRepresentation" minOccurs="0"/>
					<xsd:element ref="bkcmecf:OwnershipInterestCode" minOccurs="0"/>
					<xsd:element ref="bkcmecf:CommunityDebtIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimSubjectToOffsetIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimIncurredDate" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimContingentIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimUnliquidatedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:ClaimDisputedIndicator" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PriorityUnsecuredClaimCode" minOccurs="0"/>
					<xsd:element ref="bkcmecf:NonPriorityUnsecuredClaimCode" minOccurs="0"/>
					<xsd:element ref="bkcmecf:OtherClaimDescription" minOccurs="0"/>
					<xsd:element ref="bkcmecf:UnsecuredClaimAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:PriorityClaimAmount" minOccurs="0"/>
					<xsd:element ref="bkcmecf:NonPriorityClaimAmount" minOccurs="0"/>
