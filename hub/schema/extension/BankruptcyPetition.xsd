				<xsd:annotation>
					<xsd:documentation>Limited Notice</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="ntcapr">
				<xsd:annotation>
					<xsd:documentation>Notice of Appearance</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
				<xsd:annotation>
					<xsd:documentation>Not known</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
