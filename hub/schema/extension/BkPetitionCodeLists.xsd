<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:bank="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/codes/1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:s="http://niem.gov/niem/structures/2.0" targetNamespace="http://cmecf.td.oca.ao.dcn/niem/bankruptcy/codes/1.0">
	<xsd:annotation>
		<xsd:documentation>Abbreviations of categories of Bankruptcy Petitition information</xsd:documentation>
		<xsd:appinfo>
			<s:ConformantIndicator>true</s:ConformantIndicator>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:import namespace="http://niem.gov/niem/appinfo/2.0" schemaLocation="../appinfo/2.0/appinfo.xsd"/>
	<xsd:import namespace="http://niem.gov/niem/structures/2.0" schemaLocation="../structures/2.0/structures.xsd"/>
	<xsd:complexType name="BankruptcyCaseVoluntaryInvoluntaryCodeType">
		<xsd:annotation>
			<xsd:documentation>Whether the debtor has initiated bankruptcy ("v") or a creditor has initiated bankruptcy ("i").</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:VoluntaryInvoluntarySimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="BankruptcyChapterType">
		<xsd:annotation>
			<xsd:documentation>The various chapters of US Code defining distinct legal forms of Bankruptcy.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:BankruptcyChapterSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="Chapter11PlanCodeType">
		<xsd:annotation>
			<xsd:documentation>In a chapter 11 case, regarding a pre-packaged plan, was a plan filed and or accepted.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:Chapter11PlanSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="Chapter15CaseCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>In a chapter 15 case, whether for recognition of a foreign main, nonmain or alternative proceeding.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:Chapter15CaseCategorySimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="DebtorTypeCodeType">
		<xsd:annotation>
			<xsd:documentation>Types of entities who can file for Bankruptcy on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:DebtorFormOrganizationSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="EstimatedAssetsCodeType">
		<xsd:annotation>
			<xsd:documentation>Codes for ranges of total value of debtor assets on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:EstimatedAssetsSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="EstimatedCreditorsCodeType">
