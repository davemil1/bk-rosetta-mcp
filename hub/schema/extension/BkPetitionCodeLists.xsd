					<xsd:documentation>Gas</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="Heating Oil">
				<xsd:annotation>
					<xsd:documentation>Heating Oil</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="Security Deposit">
				<xsd:annotation>
					<xsd:documentation>Security deposit on rental unit</xsd:documentation>
