			<xsd:extension base="bank:EstimatedCreditorsSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="EstimatedLiabilitiesCodeType">
		<xsd:annotation>
			<xsd:documentation>Codes for ranges of total value of debtor liabilities on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:EstimatedLiabilitiesSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="FilingFeeStatusCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of filing fee status on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:FilingFeeStatusSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="NatureOfBusinessCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of businesses on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:NatureOfBusinessSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="NatureOfDebtsCodeType">
		<xsd:annotation>
			<xsd:documentation>Indicator of what nature of debtors debts are on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:NatureOfDebtsSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="NatureOfSuitCodeType">
		<xsd:annotation>
			<xsd:documentation>An enumeration of possible natures of suit in a bankruptcy case.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:NatureOfSuitSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="NonPriorityUnsecuredClaimCodeType">
		<xsd:annotation>
			<xsd:documentation>Type of NONPRIORITY unsecured claim.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:NonPriorityUnsecuredClaimSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="PriorityUnsecuredClaimCodeType">
		<xsd:annotation>
			<xsd:documentation>Type of PRIORITY unsecured claim.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:PriorityUnsecuredClaimSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="PropertyIntentionCodeType">
		<xsd:annotation>
			<xsd:documentation>Categories of intention of the property that secures a debt.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="bank:PropertyIntentionSimpleCodeType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="BankruptcyChapterSimpleType">
		<xsd:annotation>
			<xsd:documentation>The various chapters of US Code defining distinct legal forms of Bankruptcy.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="7">
				<xsd:annotation>
					<xsd:documentation>Chapter 7: Liquidation</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="9">
				<xsd:annotation>
					<xsd:documentation>Chapter 9: Municipal</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="11">
				<xsd:annotation>
					<xsd:documentation>Chapter 11: Reorganization</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="12">
				<xsd:annotation>
					<xsd:documentation>Chapter 12: Farmers and fishermen</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="13">
				<xsd:annotation>
					<xsd:documentation>Chapter 13: Rehabilitation with payment plan</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="15">
				<xsd:annotation>
					<xsd:documentation>Chapter 15: International</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="304">
				<xsd:annotation>
					<xsd:documentation>Chapter 304: Ancillary to foreign insolvency</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
				<xsd:annotation>
					<xsd:documentation>Chapter not set, as for a value of previous bankruptcy chapter where a case has not been converted.</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="Chapter11PlanSimpleCodeType">
		<xsd:annotation>
			<xsd:documentation>In a chapter 11 case, regarding a pre-packaged plan, whether:</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="Y">
				<xsd:annotation>
					<xsd:documentation>A plan was filed</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="P">
				<xsd:annotation>
					<xsd:documentation>A plan was accepted</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="B">
				<xsd:annotation>
					<xsd:documentation>Both of the above</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
				<xsd:annotation>
					<xsd:documentation>Neither of the above</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="Chapter15CaseCategorySimpleCodeType">
		<xsd:annotation>
			<xsd:documentation>In a chapter 15 case, whether for recognition of a foreign main, nonmain or alternative proceeding .</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="m">
				<xsd:annotation>
					<xsd:documentation>Foreign main proceeding</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="n">
				<xsd:annotation>
					<xsd:documentation>Foreign nonmain proceeding</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="a">
				<xsd:annotation>
					<xsd:documentation>Foreign main proceeding, or in the alternative foreign nonmain proceeding</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
				<xsd:annotation>
					<xsd:documentation>Neither</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="DebtorFormOrganizationSimpleCodeType">
		<xsd:annotation>
			<xsd:documentation>Types of entities who can file for Bankruptcy on the Bankruptcy Petition form.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="i">
				<xsd:annotation>
					<xsd:documentation>Individual</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="u">
				<xsd:annotation>
					<xsd:documentation>Corporation</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="p">
				<xsd:annotation>
					<xsd:documentation>Partnership</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="n">
				<xsd:annotation>
					<xsd:documentation>Other</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="">
				<xsd:annotation>
					<xsd:documentation>Not known</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="DebtorOwnSecurityDepositType">
		<xsd:annotation>
			<xsd:documentation>Security deposit account type.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
