  <pattern id="cross-field">
    <title>Cross-field rules the workbook states in English, translated by hand</title>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101">
      <assert id="BCO-101-0102-c" test="not(bkcmecf:BankruptcyChapter = '12') or bkcmecf:NatureOfDebtsCode = 'b'" role="error">BCO-101-0102 c): For a chapter 12 case, the nature of debt must be business.</assert>
    </rule>
    <rule context="//nc:PersonSSNIdentification/nc:IdentificationID">
      <assert id="BCO-101-0014-a" test="translate(normalize-space(.), '0123456789', '9999999999') = '999-99-9999'" role="error">BCO-101-0014 a): SSN/ITIN format must be xxx-xx-xxxx.</assert>
    </rule>
    <rule context="//nc:OrganizationTaxIdentification/nc:IdentificationID">
      <assert id="BCO-101-0016-a" test="translate(normalize-space(.), '0123456789', '9999999999') = '99-9999999'" role="error">BCO-101-0016 a): EIN format must be xx-xxxxxxx.</assert>
    </rule>
  </pattern>

  <pattern id="consistency">
    <title>Consistency warnings between the Form 101 estimates and the Form 106Sum schedule totals (not workbook rules)</title>
    <let name="totalLiabilities" value="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB106Sum/bkcmecf:TotalLiabilitiesAmount"/>
    <let name="totalAssets" value="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB106Sum/bkcmecf:TotalPropertyValueAmount"/>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:EstimatedLiabilitiesCode">
      <assert id="XF-estimated-liabilities" test="not($totalLiabilities) or (. = 'A' and $totalLiabilities &gt;= 0 and $totalLiabilities &lt;= 50000) or (. = 'B' and $totalLiabilities &gt;= 50001 and $totalLiabilities &lt;= 100000) or (. = 'C' and $totalLiabilities &gt;= 100000 and $totalLiabilities &lt;= 500000) or (. = 'D' and $totalLiabilities &gt;= 500001 and $totalLiabilities &lt;= 1000000) or (. = 'E' and $totalLiabilities &gt;= 1000001 and $totalLiabilities &lt;= 10000000) or (. = 'F' and $totalLiabilities &gt;= 10000001 and $totalLiabilities &lt;= 50000000) or (. = 'G' and $totalLiabilities &gt;= 50000001 and $totalLiabilities &lt;= 100000000) or (. = 'H' and $totalLiabilities &gt;= 100000001 and $totalLiabilities &lt;= 500000000) or (. = 'I' and $totalLiabilities &gt;= 500000001 and $totalLiabilities &lt;= 1000000000) or (. = 'K' and $totalLiabilities &gt;= 1000000001 and $totalLiabilities &lt;= 10000000000) or (. = 'L' and $totalLiabilities &gt;= 10000000001 and $totalLiabilities &lt;= 50000000000) or (. = 'M' and $totalLiabilities &gt;= 50000000001)" role="warning">Form 101 line 20 estimates liabilities as range <value-of select="."/>, but Form 106Sum line 3 totals <value-of select="$totalLiabilities"/>.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:EstimatedAssetsCode">
      <assert id="XF-estimated-assets" test="not($totalAssets) or (. = 'A' and $totalAssets &gt;= 0 and $totalAssets &lt;= 50000) or (. = 'B' and $totalAssets &gt;= 50001 and $totalAssets &lt;= 100000) or (. = 'C' and $totalAssets &gt;= 100000 and $totalAssets &lt;= 500000) or (. = 'D' and $totalAssets &gt;= 500001 and $totalAssets &lt;= 1000000) or (. = 'E' and $totalAssets &gt;= 1000001 and $totalAssets &lt;= 10000000) or (. = 'F' and $totalAssets &gt;= 10000001 and $totalAssets &lt;= 50000000) or (. = 'G' and $totalAssets &gt;= 50000001 and $totalAssets &lt;= 100000000) or (. = 'H' and $totalAssets &gt;= 100000001 and $totalAssets &lt;= 500000000) or (. = 'I' and $totalAssets &gt;= 500000001 and $totalAssets &lt;= 1000000000) or (. = 'K' and $totalAssets &gt;= 1000000001 and $totalAssets &lt;= 10000000000) or (. = 'L' and $totalAssets &gt;= 10000000001 and $totalAssets &lt;= 50000000000) or (. = 'M' and $totalAssets &gt;= 50000000001)" role="warning">Form 101 line 19 estimates assets as range <value-of select="."/>, but Form 106Sum line 1c totals <value-of select="$totalAssets"/>.</assert>
    </rule>
  </pattern>
</schema>
