    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:EstimatedCreditorsCode">
      <assert id="BCO-101-0106-values" test=". = 'A' or . = 'B' or . = 'C' or . = 'D' or . = 'E' or . = 'F' or . = 'G' or . = 'H' or . = 'I' or . = 'J'" role="error">BCO-101-0106: A value for the number of creditors is required. (FormB101 DebtorNumberOfCreditors) Allowed: A, B, C, D, E, F, G, H, I, J.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:EstimatedAssetsCode">
