  <pattern id="B101">
    <title>B101 Voluntary Petition</title>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:FormAmendedIndicator">
      <assert id="BCO-101-0003-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0003: a)BankruptcyPetition must not contain amended or supplemental data when opening a case. b) BankruptcyPetition must contain amended or supplemental data when docketing using XML. Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101">
      <assert id="BCO-101-0004-required" test="bkcmecf:BankruptcyChapter" role="error">BCO-101-0004: Chapter must be 7, 11, 12, or 13. (FormB101 BankruptcyChapter)</assert>
      <assert id="BCO-101-0057-required" test="bkcmecf:DebtorTypeCode" role="error">BCO-101-0057: Type of debtor must be individual. (DebtorTypeCode = i)</assert>
      <assert id="BCO-101-0064-required" test="bkcmecf:FilingFeeStatusCode" role="error">BCO-101-0064: a) The filing fee is required. b) The voluntary chapter 7 filing fee status must be paid in installments, paid in full, or fee waived. (FormB101 FilingFeeStatusCode = i, p, or w) c) The filing fee status for chapters 11, 12, and 13 must be paid in installments or paid in full. (FormB101 FilingFeeStatusCode = i or p) d) The filing fee status can only be waived for a chapter 7 case. (FormB101 FilingFeeStatusCode = w)</assert>
      <assert id="BCO-101-0065-required" test="bkcmecf:PriorBankruptcyCaseIndicator" role="error">BCO-101-0065: a) Default error message from schema validation b) Default error message from schema validation c) PriorBankruptcyCaseIndicator cannot be true for an involuntary petition.</assert>
      <assert id="BCO-101-0102-required" test="bkcmecf:NatureOfDebtsCode" role="error">BCO-101-0102: a)The nature of debt must be business, consumer or other. (FormB101 NatureOfDebtsCode = b, c or o) b) Default error message from schema validation c) For a chapter 12 case, the nature of debt must be business(bkcmecf:FormB101 NatureOfDebts)</assert>
      <assert id="BCO-101-0106-required" test="bkcmecf:EstimatedCreditorsCode" role="error">BCO-101-0106: A value for the number of creditors is required. (FormB101 DebtorNumberOfCreditors)</assert>
      <assert id="BCO-101-0107-required" test="bkcmecf:EstimatedAssetsCode" role="error">BCO-101-0107: A value for estimated assets is required. (FormB101 DebtorEstimatedAssetsAmountCode)</assert>
      <assert id="BCO-101-0108-required" test="bkcmecf:EstimatedLiabilitiesCode" role="error">BCO-101-0108: A value for estimated liabilities is required. (FormB101 DebtorEstimatedLiabilitiesAmountCode)</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyChapter">
      <assert id="BCO-101-0004-values" test=". = '7' or . = '11' or . = '12' or . = '13'" role="error">BCO-101-0004: Chapter must be 7, 11, 12, or 13. (FormB101 BankruptcyChapter) Allowed: 7, 11, 12, 13.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor1/nc:EntityPerson/nc:PersonName">
      <assert id="BCO-101-0007-required" test="nc:PersonSurName" role="error">BCO-101-0007: Debtor1's last name is required. (FormB101 PersonSurName)</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor1/nc:EntityPerson/bkcmecf:Alias/bkcmecf:AliasTypeCode">
      <assert id="BCO-101-0013-values" test=". = 'aka' or . = 'fka' or . = 'dba' or . = 'fdba'" role="error">BCO-101-0013: Alias code is required for Debtor1's alias name. (FormB101 AliasTypeCode). Default error message from schema validation Allowed: aka, fka, dba, fdba.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor1/nc:EntityPerson/nc:NoBusinessNameIndicator">
      <assert id="BCO-101-0015-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0015: NoBusinessNameIndicator on B101 line 4 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor1/nc:EntityOrganization/nc:OrganizationLocation/nc:LocationAddress/nc:StructuredAddress">
      <assert id="BCO-101-0021-required" test="cmecfcodes:USCountyCode" role="error">BCO-101-0021: If StructuredAddress exists, validation enforced by schema</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor2/nc:EntityPerson/bkcmecf:Alias/bkcmecf:AliasTypeCode">
      <assert id="BCO-101-0039-values" test=". = 'aka' or . = 'fka' or . = 'dba' or . = 'fdba'" role="error">BCO-101-0039: Alias code is required for Debtor2's alias name. (FormB101 AliasTypeCode) Default error message from schema validation Allowed: aka, fka, dba, fdba.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor2/nc:EntityPerson/nc:NoBusinessNameIndicator">
      <assert id="BCO-101-0041-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0041: NoBusinessNameIndicator on B101 line 4 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:BankruptcyDebtor2/nc:EntityOrganization/nc:OrganizationLocation/nc:LocationAddress/nc:StructuredAddress">
      <assert id="BCO-101-0047-required" test="cmecfcodes:USCountyCode" role="error">BCO-101-0047: If StructuredAddress exists, validation enforced by schema</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:DebtorTypeCode">
      <assert id="BCO-101-0057-values" test=". = 'i'" role="error">BCO-101-0057: Type of debtor must be individual. (DebtorTypeCode = i) Allowed: i.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor1FilingVenue/bkcmecf:EstablishedByDomicileIndicator">
      <assert id="BCO-101-0058-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0058: EstablishedByDomicileIndicator on B101 line 6 Col 1-CB1 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor1FilingVenue/bkcmecf:EstablishedByOtherIndicator">
      <assert id="BCO-101-0059-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0059: EstablishedByOtherIndicator on B101 line 6 Col 1-CB2 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor2FilingVenue/bkcmecf:EstablishedByDomicileIndicator">
      <assert id="BCO-101-0061-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0061: EstablishedByDomicileIndicator on B101 line 6 Col 2-CB1 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor2FilingVenue/bkcmecf:EstablishedByOtherIndicator">
      <assert id="BCO-101-0062-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0062: EstablishedByOtherIndicator on B101 line 6 Col2-CB2 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:FilingFeeStatusCode">
      <assert id="BCO-101-0064-values" test=". = 'p' or . = 'i' or . = 'w'" role="error">BCO-101-0064: a) The filing fee is required. b) The voluntary chapter 7 filing fee status must be paid in installments, paid in full, or fee waived. (FormB101 FilingFeeStatusCode = i, p, or w) c) The filing fee status for chapters 11, 12, and 13 must be paid in installments or paid in full. (FormB101 FilingFeeStatusCode = i or p) d) The filing fee status can only be waived for a chapter 7 case. (FormB101 FilingFeeStatusCode = w) Allowed: p, i, w.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:PriorBankruptcyCaseIndicator">
      <assert id="BCO-101-0065-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0065: a) Default error message from schema validation b) Default error message from schema validation c) PriorBankruptcyCaseIndicator cannot be true for an involuntary petition. Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:PendingBankruptcyCaseIndicator">
      <assert id="BCO-101-0069-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0069: PendingBankruptcyCaseIndicator on B101 line 10 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:DebtorRentsResidenceIndicator">
      <assert id="BCO-101-0075-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0075: DebtorRentsResidenceIndicator on B101 line 11 CB1 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:LandlordPossessingJudgmentAgainstDebtorIndicator">
      <assert id="BCO-101-0076-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0076: LandlordPossessingJudgmentAgainstDebtorIndicator on B101 line 11 CB2 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:SoleProprietorIndicator">
      <assert id="BCO-101-0077-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0077: SoleProprietorIndicator on B101 line 12 CB1-2 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:NatureOfBusinessCode">
      <assert id="BCO-101-0085-values" test=". = 'h' or . = 'r' or . = 's' or . = 'c' or . = 'O'" role="error">BCO-101-0085: a) The nature of business must be healthcare, single asset real estate, stockbroker, commodity broker, or none of the above. (FormB101 NatureOfBusinessCode = h, r, s, c, or O) b) The nature of business is required if the nature of debt is business. (FormB101 NatureOfBusinessCode != null) Allowed: h, r, s, c, O.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Chapter11FilingIndicator">
      <assert id="BCO-101-0086-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0086: Chapter11FilingIndicator on B101 line 13 CB1 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:SmallBusinessIndicator">
      <assert id="BCO-101-0087-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0087: For a Chapter 11 case, a value for small business is required if the nature of debt is business. (FormB101 Chapter11SmallBusinessIndicator != null). SmallBusinessIndicator is only valid for Chapter 11. (bkcmecf:FormB101 SmallBusinessIndicator). Small business must be blank when Nature of debt is consumer or other. SmallBusinessIndicator is only valid for Chapter 11. (bkcmecf:FormB101 SmallBusinessIndicator). Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:HazardousPropertyIndicator">
      <assert id="BCO-101-0088-values" test=". = 'true' or . = 'false'" role="error">BCO-101-0088: HazardousPropertyIndicator on B101 line 14 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor1CreditCounseling/bkcmecf:CreditCounselingCode">
      <assert id="BCO-101-0096-values" test=". = '1' or . = '2' or . = '3' or . = '4'" role="error">BCO-101-0096: CreditCounselingCode on B101 line 15 CB1-CB4 Allowed: 1, 2, 3, 4.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor1CreditCounseling/bkcmecf:BriefingNotRequiredReasonCode">
      <assert id="BCO-101-0098-values" test=". = 'i' or . = 'd' or . = 'a'" role="error">BCO-101-0098: BriefingNotRequiredReasonCode on B101 line 15 Allowed: i, d, a.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor2CreditCounseling/bkcmecf:CreditCounselingCode">
      <assert id="BCO-101-0099-values" test=". = '1' or . = '2' or . = '3' or . = '4'" role="error">BCO-101-0099: CreditCounselingCode on B101 line 15 CB1-CB4 Allowed: 1, 2, 3, 4.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Debtor2CreditCounseling/bkcmecf:BriefingNotRequiredReasonCode">
      <assert id="BCO-101-0101-values" test=". = 'i' or . = 'd' or . = 'a'" role="error">BCO-101-0101: BriefingNotRequiredReasonCode on B101 line 15 Allowed: i, d, a.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:NatureOfDebtsCode">
      <assert id="BCO-101-0102-values" test=". = 'b' or . = 'c' or . = 'o'" role="error">BCO-101-0102: a)The nature of debt must be business, consumer or other. (FormB101 NatureOfDebtsCode = b, c or o) b) Default error message from schema validation c) For a chapter 12 case, the nature of debt must be business(bkcmecf:FormB101 NatureOfDebts) Allowed: b, c, o.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB101/bkcmecf:Chapter7FilingIndicator">
