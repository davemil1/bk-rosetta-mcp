  <pattern id="B105">
    <title>B105 Involuntary Petition</title>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:FormAmendedIndicator">
      <assert id="BCO-105-0003-values" test=". = 'true' or . = 'false'" role="error">BCO-105-0003: a)BankruptcyPetition must not contain amended or supplemental data when opening a case. b) BankruptcyPetition must contain amended or supplemental data when docketing using XML. Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105">
      <assert id="BCO-105-0004-required" test="bkcmecf:BankruptcyChapter" role="error">BCO-105-0004: Chapter must be 7 or 11 (FormB105 BankruptcyChapter)</assert>
      <assert id="BCO-105-0032-required" test="bkcmecf:DebtorTypeCode" role="error">BCO-105-0032: Type of debtor must be individual. (DebtorTypeCode = i)</assert>
      <assert id="BCO-105-0033-required" test="bkcmecf:FilingFeeStatusCode" role="error">BCO-105-0033: For B105 FilingFeeStatusCode must be 'p'.</assert>
      <assert id="BCO-105-0042-required" test="bkcmecf:NatureOfDebtsCode" role="error">BCO-105-0042: For an involuntary case, the nature of debt must be consumer or business. (FormB105 NatureOfDebtsCode = c or b)</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:BankruptcyChapter">
      <assert id="BCO-105-0004-values" test=". = '7' or . = '11'" role="error">BCO-105-0004: Chapter must be 7 or 11 (FormB105 BankruptcyChapter) Allowed: 7, 11.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:BankruptcyDebtor1/nc:EntityPerson/nc:PersonName">
      <assert id="BCO-105-0007-required" test="nc:PersonSurName" role="error">BCO-105-0007: Debtor1's last name is required (FormB105 PersonSurName).</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:BankruptcyDebtor1/nc:EntityPerson/bkcmecf:Alias/bkcmecf:AliasTypeCode">
      <assert id="BCO-105-0013-values" test=". = 'aka' or . = 'fka' or . = 'dba' or . = 'fdba'" role="error">BCO-105-0013: Alias code is required for Debtor1's alias name. (FormB105 AliasTypeCode). Default error message from schema validation Allowed: aka, fka, dba, fdba.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:BankruptcyDebtor1/nc:EntityOrganization/nc:OrganizationTaxIndicator">
      <assert id="BCO-105-0016-values" test=". = 'true' or . = 'false'" role="error">BCO-105-0016: OrganizationTaxIndicator on B105 line 5 Allowed: true, false.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:BankruptcyDebtor1/nc:EntityOrganization/nc:OrganizationLocation/nc:LocationAddress/nc:StructuredAddress">
      <assert id="BCO-105-0021-required" test="cmecfcodes:USCountyCode" role="error">BCO-105-0021: Validation enforced by schema</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:DebtorTypeCode">
      <assert id="BCO-105-0032-values" test=". = 'i'" role="error">BCO-105-0032: Type of debtor must be individual. (DebtorTypeCode = i) Allowed: i.</assert>
    </rule>
    <rule context="/bkcmecf:IndividualBankruptcyPetition/bkcmecf:FormB105/bkcmecf:FilingFeeStatusCode">
      <assert id="BCO-105-0033-values" test=". = 'p'" role="error">BCO-105-0033: For B105 FilingFeeStatusCode must be 'p'. Allowed: p.</assert>
